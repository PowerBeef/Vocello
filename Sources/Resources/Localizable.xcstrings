    "vocello.enrollment.use_audio_only.hint": {
      "comment": "VoiceOver hint for the explicit audio-only enrollment action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this reference without transcript-backed delivery."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre cette référence sans conditionnement par transcription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda esta referencia sin una interpretación basada en transcripción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert diese Referenz ohne transkriptgestützte Sprechweise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva questo riferimento senza interpretazione basata sulla trascrizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva esta referência sem interpretação baseada em transcrição."
          }
        },
        "zh-Hans": {
