          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il consenso alla clonazione in Impostazioni → Privacy prima di salvare una voce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o consentimento de clonagem em Ajustes → Privacidade antes de salvar uma voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存声音前请在“设置 → 隐私”中启用声音克隆授权。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
