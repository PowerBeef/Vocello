{
  "schemaVersion": 1,
  "confidenceLevel": 0.95,
  "minimumCalibrationClips": 60,
  "minimumHoldoutGoodClips": 60,
  "minimumHoldoutBadClips": 60,
  "minimumHoldoutSpeakerGroups": 3,
  "minimumHoldoutScriptGroups": 3,
  "minimumHoldoutLanguages": 3,
  "requiredLengthClasses": ["short", "medium", "long"],
  "requiredDefectSeverities": ["none", "mild", "moderate", "severe"],
  "maximumFalsePositiveRateUpperBound": 0.1,
  "minimumTruePositiveRateLowerBound": 0.7,
  "groupIsolation": ["speakerGroup", "scriptGroup", "translationGroup"],
  "samplingUnit": "independent-source-recording",
  "approvedExternalCatalogSHA256": [],
  "reviewAuthority": {
    "humanListeningRequired": false,
    "default": "independent-reference-evidence",
    "acceptedSources": ["controlled-pcm", "published-label", "optional-human-annotation"],
    "detectorSelfLabelsAllowed": false,
    "controlledFixturesQualifyPerceptualQuality": false
  },
  "annotationProtocol": {
    "id": "speech-defects-1",
    "minimumIndependentReviewers": 3,
    "minimumFluentReviewersPerClip": 1,
    "decisions": ["acceptable", "objectionable", "uncertain"],
    "defectTypes": ["interior-gap", "trailing-silence", "clipping-distortion", "truncation", "repetition", "word-spacing", "pitch-instability", "intelligibility", "wrong-language", "other"],
    "severities": {
      "none": "No audible defect identified; this is not a claim that the requested emotion was achieved.",
      "mild": "Noticeable irregularity that does not materially impair use or comprehension.",
      "moderate": "Clearly distracting defect that materially reduces usability or comprehension.",
      "severe": "Output is unusable, substantially incomplete, or seriously unintelligible."
    },
    "confidenceRange": [0, 1],
    "intervalUnit": "seconds-from-original-wav-start",
    "playback": "original-PCM-no-gain-normalization-no-trimming",
    "blindFields": ["requestedPreset", "expectedDefect", "priorQC", "sourceName", "split", "metrics"],
    "disagreement": "retain-all-responses-and-adjudicate-independently-before-binary-label-export",
    "authority": "independent-human-observation-not-analyzer-output"
  }
}
