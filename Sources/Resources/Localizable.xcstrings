          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの設定に従う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 기본값"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в системе"
