          }
        }
      }
    },
    "vocello.mac.savedVoice.speechDenied": {
      "comment": "macOS interface: notice when speech recognition permission is denied. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is off for Vocello — the transcript won't auto-fill."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est désactivée pour Vocello — la transcription ne se remplira pas automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está desactivado para Vocello; la transcripción no se rellenará automáticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracherkennung ist für Vocello deaktiviert – das Transkript wird nicht automatisch ausgefüllt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale è disattivato per Vocello: la trascrizione non verrà compilata automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está desativado para o Vocello — a transcrição não será preenchida automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello 的语音识别已关闭，转录文本不会自动填写。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello の音声認識がオフのため、文字起こしは自動入力されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello의 음성 인식이 꺼져 있어 녹취록이 자동 입력되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи для Vocello выключено — расшифровка не заполнится автоматически."
          }
        }
      }
    },
    "vocello.mac.savedVoice.siriDisabled": {
      "comment": "macOS interface: notice when Siri is disabled and dictation cannot run. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-transcription needs Siri enabled (macOS requirement) — the transcript won't auto-fill."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription automatique nécessite l’activation de Siri (exigence de macOS) — la transcription ne se remplira pas automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción automática requiere Siri activado (requisito de macOS); la transcripción no se rellenará automáticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Transkription benötigt aktiviertes Siri (macOS-Vorgabe) – das Transkript wird nicht automatisch ausgefüllt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione automatica richiede Siri attivo (requisito macOS): la trascrizione non verrà compilata automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição automática exige Siri ativada (requisito do macOS) — a transcrição não será preenchida automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动转录需要启用 Siri（macOS 要求），转录文本不会自动填写。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動文字起こしには Siri の有効化が必要です（macOS の要件）。文字起こしは自動入力されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 받아쓰기는 Siri 활성화가 필요합니다(macOS 요구 사항). 녹취록이 자동 입력되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для автоматической расшифровки нужна Siri (требование macOS) — текст не заполнится автоматически."
          }
        }
      }
    },
    "vocello.mac.settings.deleteModelMessage": {
      "comment": "macOS interface: delete-model confirmation; %1$@ mode name, %2$@ variant label, %3$@ optional size in parentheses. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
