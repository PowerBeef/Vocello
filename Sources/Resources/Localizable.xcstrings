    "vocello.settings.polish.cancelDownloadDetail": {
      "comment": "Settings polish; localized display only. Preserve placeholders and stored model/variation identities.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canceling removes the downloaded data. You can download it again from scratch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’annulation supprime les données téléchargées. Vous pourrez recommencer le téléchargement depuis le début."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cancelar se eliminan los datos descargados. Podrás volver a descargarlos desde cero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abbrechen werden die geladenen Daten entfernt. Du kannst sie später vollständig neu laden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullando verranno rimossi i dati scaricati. Potrai scaricarli di nuovo da zero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar remove os dados baixados. Você poderá baixar tudo novamente do início."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消会移除已下载的数据。之后可从头重新下载。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルするとダウンロード済みデータを削除します。後で最初からダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소하면 다운로드한 데이터가 제거됩니다. 나중에 처음부터 다시 다운로드할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При отмене загруженные данные удаляются. Позже их можно загрузить заново."
          }
        }
      }
    },
