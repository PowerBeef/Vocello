    "vocello.licenses.introduction": {
      "comment": "Introduction on the offline attribution browser.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello includes open-source software and uses separately downloaded model artifacts. These notices are stored in the app and remain available offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello intègre des logiciels libres et utilise des modèles téléchargés séparément. Ces mentions sont conservées dans l’app et restent disponibles hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello incluye software de código abierto y usa modelos descargados por separado. Estos avisos se guardan en la app y están disponibles sin conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello enthält Open-Source-Software und verwendet separat geladene Modelldateien. Diese Hinweise sind in der App gespeichert und bleiben offline verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello include software open source e usa modelli scaricati separatamente. Questi avvisi sono memorizzati nell’app e disponibili offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vocello inclui software de código aberto e usa modelos baixados separadamente. Estes avisos ficam no app e continuam disponíveis offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello 包含开源软件，并使用单独下载的模型文件。这些声明保存在应用内，离线时仍可查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello にはオープンソースソフトウェアが含まれ、モデルは別途ダウンロードします。これらの告知はアプリ内に保存され、オフラインでも確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello는 오픈 소스 소프트웨어와 별도로 다운로드하는 모델을 사용합니다. 이 고지는 앱에 저장되어 오프라인에서도 볼 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello включает ПО с открытым исходным кодом и использует отдельно загружаемые модели. Эти уведомления хранятся в приложении и доступны без сети."
          }
        }
      }
    },
