_vocello() {
  local word previous key command sub i
  local -a candidates options
  local -a value_options=( --output-format --data-dir --manifest --text --text-file --mode --variant --speaker --voice-brief --voice --reference --transcript --delivery --delivery-cell --seed --variation --language --out --long-form --out-dir --client-request-id --file --request --requests --order --limit --name --audio --transcribe --on-warnings --id --modes --variants --lengths --warm --prosody-profile --label --force-class --telemetry --memory-qualification --run-id --codec-replay --take-sha256 --codec-trace --output-dir --script-file --reference-wav --codec-roundtrip --codec-loop )

  # Find the command and subcommand typed so far, skipping options and their values.
  i=2
  while (( i < CURRENT )); do
