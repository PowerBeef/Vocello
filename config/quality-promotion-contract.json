{
  "schemaVersion": 2,
  "owner": "release-qa",
  "publicPromotionPolicy": "source-bound-quality-evidence",
  "maxEvidenceAgeSeconds": 604800,
  "allowedWarnings": [
    "memory.pressure.soft_trim"
  ],
  "platformMinimumEvidence": {
    "macos": [
      "macos-ui-benchmark"
    ],
    "ios": [
      "ios-ui-benchmark"
    ]
  },
  "evidence": {
    "macos-ui-benchmark": {
      "platform": "macos",
      "type": "benchmark-record",
      "kind": "ui-generation",
      "matrixScope": "canonical",
      "classifications": [
        "canonical"
      ],
      "requiredTakeCoverage": {
        "modes": ["custom", "design", "clone"],
        "variants": ["speed"]
      }
    },
    "ios-ui-benchmark": {
      "platform": "ios",
      "type": "benchmark-record",
      "kind": "ui-generation",
      "matrixScope": "canonical",
      "classifications": [
        "canonical"
      ],
      "requiredTakeCoverage": {
        "modes": ["custom", "design", "clone"],
        "variants": ["speed"]
      }
    },
    "macos-engine-benchmark": {
      "platform": "macos",
      "type": "benchmark-record",
      "kind": "engine-generation",
      "matrixScope": "focused",
      "classifications": [
        "focused",
        "canonical"
      ]
    },
    "ios-engine-benchmark": {
      "platform": "ios",
      "type": "benchmark-record",
      "kind": "engine-generation",
      "matrixScope": "focused",
      "classifications": [
        "focused",
        "canonical"
      ]
    },
    "macos-retained-memory": {
      "platform": "macos",
      "type": "benchmark-record",
      "kind": "memory-qualification",
      "matrixScope": "focused",
      "classifications": [
        "focused",
        "canonical"
      ]
    },
    "ios-retained-memory": {
      "platform": "ios",
      "type": "benchmark-record",
      "kind": "memory-qualification",
      "matrixScope": "focused",
      "classifications": [
        "focused",
        "canonical"
      ]
    },
    "macos-ui-performance": {
      "platform": "macos",
      "type": "benchmark-record",
      "kind": "ui-perf",
      "matrixScope": "canonical",
      "classifications": [
        "canonical"
      ]
    },
    "ios-ui-performance": {
      "platform": "ios",
      "type": "benchmark-record",
      "kind": "ui-perf",
      "matrixScope": "canonical",
      "classifications": [
        "canonical"
      ]
    },
    "macos-quality-engine-benchmark": {
      "platform": "macos",
      "type": "benchmark-record",
      "kind": "engine-generation",
      "matrixScope": "focused",
      "classifications": ["focused", "canonical"],
      "requiredTakeCoverage": {
        "modes": ["custom", "design", "clone"],
        "variants": ["quality"]
      }
    },
    "ios-quality-engine-benchmark": {
      "platform": "ios",
      "type": "benchmark-record",
      "kind": "engine-generation",
      "matrixScope": "focused",
      "classifications": ["focused", "canonical"],
      "requiredTakeCoverage": {
        "modes": ["custom", "design", "clone"],
        "variants": ["quality"]
      }
    },
    "macos-language-benchmark": {
      "platform": "macos",
      "type": "benchmark-record",
      "kind": "language",
      "matrixScope": "focused",
      "classifications": ["focused", "canonical"],
      "requiredTakeCoverage": {
        "variants": ["speed"],
        "cellPatterns": [
          "custom-en-*", "custom-zh-*", "custom-de-*", "custom-fr-*",
          "custom-ru-*", "custom-pt-*", "custom-es-*", "custom-it-*",
          "custom-ja-*", "custom-ko-*"
        ]
      }
    },
    "ios-language-benchmark": {
      "platform": "ios",
      "type": "benchmark-record",
      "kind": "language",
      "matrixScope": "focused",
      "classifications": ["focused", "canonical"],
      "requiredTakeCoverage": {
        "variants": ["speed"],
        "cellPatterns": [
          "custom-en-*", "custom-zh-*", "custom-de-*", "custom-fr-*",
          "custom-ru-*", "custom-pt-*", "custom-es-*", "custom-it-*",
          "custom-ja-*", "custom-ko-*"
        ]
      }
    },
    "macos-delivery-benchmark": {
      "platform": "macos",
      "type": "benchmark-record",
      "kind": "engine-generation",
      "matrixScope": "focused",
      "classifications": ["focused", "canonical"],
      "requiredTakeCoverage": {
        "variants": ["speed"],
        "cellPatterns": ["*#delivery-*"],
        "metricKeys": ["deliveryProsodyEffect"]
      }
    },
    "ios-delivery-benchmark": {
      "platform": "ios",
      "type": "benchmark-record",
      "kind": "engine-generation",
      "matrixScope": "focused",
      "classifications": ["focused", "canonical"],
      "requiredTakeCoverage": {
        "variants": ["speed"],
        "cellPatterns": ["*#delivery-*"],
        "metricKeys": ["deliveryProsodyEffect"]
      }
    },
    "macos-model-download-lifecycle": {
      "platform": "macos",
      "type": "managed-command",
      "command": [
        "./scripts/build.sh",
        "cli",
        "models",
        "install",
        "pro_custom_speed",
        "--data-dir",
        "build/scratch/transient/model-download-acceptance",
        "--verbose"
      ]
    },
    "ios-model-download-lifecycle": {
      "platform": "ios",
      "type": "managed-command",
      "command": [
        "scripts/ui_test.sh",
        "ios",
        "model-download"
      ]
    }
  },
  "capabilities": {
    "speed-generation": {
      "evidenceByPlatform": {
        "macos": ["macos-ui-benchmark"],
        "ios": ["ios-ui-benchmark"]
      },
      "unsupportedDimensions": []
    },
    "quality-generation": {
      "evidenceByPlatform": {
        "macos": ["macos-quality-engine-benchmark"],
        "ios": ["ios-quality-engine-benchmark"]
      },
      "unsupportedDimensions": ["multilingual-quality", "delivery-quality"]
    },
    "studio-modes": {
      "evidenceByPlatform": {
        "macos": ["macos-ui-benchmark"],
        "ios": ["ios-ui-benchmark"]
      },
      "unsupportedDimensions": []
    },
    "multilingual-output": {
      "evidenceByPlatform": {
        "macos": ["macos-language-benchmark"],
        "ios": ["ios-language-benchmark"]
      },
      "unsupportedDimensions": ["clone-mode", "quality-tier", "independent-generation-cohorts"]
    },
    "delivery-evaluation": {
      "evidenceByPlatform": {
        "macos": ["macos-delivery-benchmark"],
        "ios": ["ios-delivery-benchmark"]
      },
      "unsupportedDimensions": ["quality-tier", "independent-holdout-calibration"]
    },
    "model-lifecycle": {
      "evidenceByPlatform": {
        "macos": ["macos-model-download-lifecycle"],
        "ios": ["ios-model-download-lifecycle"]
      },
      "unsupportedDimensions": []
    }
  },
  "privacy": {
    "deviceIdentity": "canonical-hardware-profile-only",
    "forbiddenKeys": [
      "deviceIdentifier",
      "deviceName",
      "hostName",
      "serialNumber",
      "udid",
      "userName"
    ]
  }
}
