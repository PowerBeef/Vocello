          "stringUnit": {
            "state": "translated",
            "value": "Export Audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter l’audio"
          }
        }
      }
    },
    "vocello.player.dismiss_detail": {
      "comment": "Player dismissal does not guarantee that the take's History write succeeded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This closes the player without deleting the audio file. Saved takes can be replayed from History."
