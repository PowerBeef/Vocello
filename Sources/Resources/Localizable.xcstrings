    "vocello.ui.qualitySoft": {
      "comment": "iOS display-only qualitySoft; preserve model IDs, prompt text and warning policy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clones from references outside this range still work, but may sound less consistent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clones issus de références hors de cette plage fonctionnent toujours, mais peuvent être moins cohérents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las referencias fuera de este intervalo también funcionan, pero pueden dar resultados menos constantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenzen außerhalb dieses Bereichs funktionieren ebenfalls, können aber weniger konsistent klingen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I riferimenti fuori da questo intervallo funzionano comunque, ma possono dare risultati meno costanti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Referências fora desse intervalo ainda funcionam, mas podem soar menos consistentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此范围之外的参考音频仍可使用，但效果可能不够稳定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲外の参照音声でも動作しますが、結果が不安定になることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 범위 밖의 참조도 작동하지만 결과가 덜 일관될 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образцы вне этого диапазона тоже работают, но результат может быть менее стабильным."
          }
        }
      }
