    "vocello.mac.audio.folderMissing": {
      "comment": "macOS interface: Settings notice when the custom output folder disappeared. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen folder no longer exists — new audio saves to the default outputs folder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier choisi n’existe plus — les nouveaux fichiers audio sont enregistrés dans le dossier de sorties par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta elegida ya no existe; el audio nuevo se guardará en la carpeta de salida predeterminada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gewählte Ordner existiert nicht mehr – neues Audio wird im Standard-Ausgabeordner gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella scelta non esiste più: il nuovo audio verrà salvato nella cartella di output predefinita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta escolhida não existe mais — novos áudios serão salvos na pasta de saída padrão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件夹已不存在，新音频将保存到默认输出文件夹。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォルダがありません。新しい音声は標準の出力フォルダに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 폴더가 더 이상 없습니다. 새 오디오는 기본 출력 폴더에 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная папка больше не существует — новое аудио сохраняется в папку результатов по умолчанию."
          }
        }
      }
    },
    "vocello.mac.audio.folderNotWritable": {
      "comment": "macOS interface: Settings notice when the custom output folder is read-only. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen folder isn't writable — new audio saves to the default outputs folder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier choisi n’est pas accessible en écriture — les nouveaux fichiers audio sont enregistrés dans le dossier de sorties par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede escribir en la carpeta elegida; el audio nuevo se guardará en la carpeta de salida predeterminada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gewählte Ordner ist nicht beschreibbar – neues Audio wird im Standard-Ausgabeordner gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella scelta non è scrivibile: il nuovo audio verrà salvato nella cartella di output predefinita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível gravar na pasta escolhida — novos áudios serão salvos na pasta de saída padrão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件夹无法写入，新音频将保存到默认输出文件夹。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォルダに書き込めません。新しい音声は標準の出力フォルダに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 폴더에 쓸 수 없습니다. 새 오디오는 기본 출력 폴더에 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная папка недоступна для записи — новое аудио сохраняется в папку результатов по умолчанию."
          }
        }
      }
    },
