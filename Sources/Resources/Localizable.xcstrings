    "vocello.mac.custom.generatingFinalAudioDetail": {
      "comment": "macOS interface: Built-in Voice readiness detail while a take renders. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendering the complete take. The file lands in the player when ready."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendu de la prise complète. Le fichier arrive dans le lecteur dès qu’il est prêt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesando la toma completa. El archivo aparecerá en el reproductor cuando esté listo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vollständige Aufnahme wird berechnet. Die Datei erscheint im Player, sobald sie fertig ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elaborazione del take completo. Il file apparirà nel lettore quando sarà pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Processando a tomada completa. O arquivo aparece no player quando estiver pronto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理完整音频。就绪后文件会显示在播放器中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全なテイクを処理中です。準備ができるとプレーヤーにファイルが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 테이크를 처리하고 있습니다. 준비되면 플레이어에 파일이 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрабатывается полный дубль. Когда файл будет готов, он появится в плеере."
          }
        }
      }
    },
    "vocello.mac.custom.addScriptDetail": {
      "comment": "macOS interface: Built-in Voice readiness detail when the script is empty. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker and delivery are set. Add a line to generate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Locuteur et interprétation sont réglés. Ajoutez une réplique pour générer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz y la interpretación están elegidas. Añade una frase para generar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimme und Sprechweise sind festgelegt. Füge einen Text zum Erzeugen hinzu."
