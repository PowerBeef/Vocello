            "state": "translated",
            "value": "L’accès au microphone est refusé. Activez-le dans Réglages Système pour enregistrer."
          }
        }
      }
    },
    "vocello.mac.record.failedToStart": {
      "comment": "macOS interface: record sheet status when the recorder failed to start. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording couldn't start. Check your microphone in System Settings → Sound, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement n’a pas pu démarrer. Vérifiez votre microphone dans Réglages Système → Son, puis réessayez."
          }
        }
      }
    },
    "vocello.mac.record.idleHint": {
      "comment": "macOS interface: record sheet instructions before recording. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Record, then read 10–20 s of clean, natural speech. Quiet room. One voice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Enregistrer, puis lisez 10 à 20 s de parole naturelle et propre. Pièce calme. Une seule voix."
          }
        }
      }
    },
    "vocello.mac.record.keepGoing": {
      "comment": "macOS interface: record sheet status under the minimum duration. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep recording. 10 second minimum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez l’enregistrement. 10 secondes minimum."
          }
        }
      }
    },
    "vocello.mac.record.soundsGood": {
      "comment": "macOS interface: record sheet status within the recommended duration. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds good. Click Stop when ready."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça sonne bien. Cliquez sur Arrêter quand vous êtes prêt."
          }
        }
