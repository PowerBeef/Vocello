    "vocello.mac.cloning.siriRequired": {
      "comment": "macOS interface: hint under the transcript field when speech recognition needs Siri. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-transcription needs Siri enabled (macOS requirement) — type the transcript or enable Siri in System Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription automatique nécessite Siri (exigence de macOS) — saisissez la transcription ou activez Siri dans Réglages Système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción automática requiere Siri activado (requisito de macOS); escribe la transcripción o activa Siri en Ajustes del Sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Transkription benötigt aktiviertes Siri (macOS-Vorgabe) – gib das Transkript ein oder aktiviere Siri in den Systemeinstellungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione automatica richiede Siri attivo (requisito macOS): scrivi la trascrizione o attiva Siri in Impostazioni di Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição automática exige Siri ativada (requisito do macOS) — digite a transcrição ou ative a Siri nos Ajustes do Sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动转录需要启用 Siri（macOS 要求）。请输入转录文本，或在系统设置中启用 Siri。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動文字起こしには Siri の有効化が必要です（macOS の要件）。文字起こしを入力するか、システム設定で Siri を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 받아쓰기는 Siri 활성화가 필요합니다(macOS 요구 사항). 녹취록을 입력하거나 시스템 설정에서 Siri를 켜세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для автоматической расшифровки нужна Siri (требование macOS). Введите текст или включите Siri в Системных настройках."
          }
        }
      }
    },
    "vocello.mac.cloning.speechRecognitionOff": {
      "comment": "macOS interface: hint under the transcript field when speech recognition was denied. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is off for Vocello — type the transcript or enable it in System Settings → Privacy & Security."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est désactivée pour Vocello — saisissez la transcription ou activez-la dans Réglages Système → Confidentialité et sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está desactivado para Vocello; escribe la transcripción o actívalo en Ajustes del Sistema → Privacidad y seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracherkennung ist für Vocello deaktiviert – gib das Transkript ein oder aktiviere sie unter Systemeinstellungen → Datenschutz & Sicherheit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale è disattivato per Vocello: scrivi la trascrizione o abilitalo in Impostazioni di Sistema → Privacy e sicurezza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está desativado para o Vocello — digite a transcrição ou ative-o em Ajustes do Sistema → Privacidade e Segurança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello 的语音识别已关闭。请输入转录文本，或在“系统设置 → 隐私与安全性”中启用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello の音声認識がオフです。文字起こしを入力するか、「システム設定 → プライバシーとセキュリティ」で有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello의 음성 인식이 꺼져 있습니다. 녹취록을 입력하거나 시스템 설정 → 개인정보 보호 및 보안에서 활성화하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи для Vocello выключено. Введите текст или включите его в «Системные настройки → Конфиденциальность и безопасность»."
          }
        }
      }
    },
    "vocello.mac.cloning.transcriptLoadFailed": {
      "comment": "macOS interface: warning when a saved voice's transcript file cannot be read; %@ is the voice name. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the saved transcript for “%@”. You can still clone from the audio file alone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger la transcription enregistrée de « %@ ». Vous pouvez tout de même cloner à partir de l’audio seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la transcripción guardada de «%@». Puedes seguir clonando solo con el archivo de audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gespeicherte Transkript für „%@“ konnte nicht geladen werden. Du kannst weiterhin nur mit der Audiodatei klonen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare la trascrizione salvata per “%@”. Puoi comunque clonare usando solo il file audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar a transcrição salva de “%@”. Você ainda pode clonar usando apenas o arquivo de áudio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入“%@”的已保存转录。仍可仅使用音频文件进行克隆。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の保存済み文字起こしを読み込めませんでした。音声ファイルのみでのクローンは可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”의 저장된 녹취록을 불러오지 못했습니다. 오디오 파일만으로 복제할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить расшифровку для «%@». Клонирование только по аудиофайлу по-прежнему доступно."
          }
        }
      }
    },
    "vocello.mac.cloning.savedVoiceUnavailable": {
      "comment": "macOS interface: shown when a staged saved-voice reference file no longer exists by the time Voice Cloning opens. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That saved voice’s reference audio is no longer available. Choose another reference."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio de référence de cette voix enregistrée n’est plus disponible. Choisissez une autre référence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de referencia de esa voz guardada ya no está disponible. Elige otra referencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Referenzaudio dieser gespeicherten Stimme ist nicht mehr verfügbar. Wähle eine andere Referenz."
