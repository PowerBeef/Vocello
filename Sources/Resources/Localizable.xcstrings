    "vocello.mac.workflow.heavyHelp": {
      "comment": "macOS interface: tooltip of the Heavy badge in the generation workflow. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This package is heavy for this Mac's memory. Generation may be slow or unstable under pressure."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce paquet est lourd pour la mémoire de ce Mac. La génération peut être lente ou instable sous pression."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este paquete exige mucha memoria para este Mac. La generación puede ser lenta o inestable con poca memoria disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Paket beansprucht den Arbeitsspeicher dieses Macs stark. Bei Speicherdruck kann die Generierung langsam oder instabil sein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo pacchetto richiede molta memoria per questo Mac. La generazione può essere lenta o instabile quando la memoria scarseggia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pacote exige muita memória deste Mac. A geração pode ficar lenta ou instável sob pressão de memória."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型包对这台 Mac 的内存需求较高。内存紧张时生成可能较慢或不稳定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパッケージは、この Mac のメモリに対して高負荷です。メモリ不足時に生成が遅くなったり不安定になったりする場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패키지는 이 Mac의 메모리에 부담이 큽니다. 메모리가 부족하면 생성이 느리거나 불안정할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пакет требует много памяти для данного Mac. При нехватке памяти генерация может быть медленной или нестабильной."
          }
        }
      }
    },
