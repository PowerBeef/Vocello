    "vocello.mac.history.clearMessage": {
      "comment": "macOS interface: confirmation message for clearing History; %@ is the entry count. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes all %@ history entries. The generated audio files stay on disk in your outputs folder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime les %@ entrées de l’historique. Les fichiers audio générés restent sur le disque dans votre dossier de sorties."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina las %@ entradas del historial. Los archivos de audio generado permanecen en la carpeta de salida del disco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt alle %@ Verlaufseinträge. Die erzeugten Audiodateien bleiben im Ausgabeordner auf der Festplatte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove tutte le %@ voci della cronologia. I file audio generati restano sul disco nella cartella di output."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todas as %@ entradas do histórico. Os arquivos de áudio gerados permanecem no disco, na pasta de saída."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除全部 %@ 条历史记录。生成的音频文件仍保留在磁盘的输出文件夹中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴 %@ 件をすべて削除します。生成した音声ファイルはディスクの出力フォルダに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 항목 %@개를 모두 제거합니다. 생성된 오디오 파일은 디스크의 출력 폴더에 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
