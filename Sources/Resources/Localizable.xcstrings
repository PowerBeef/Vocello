    "vocello.mac.custom.engineBusyDetail": {
      "comment": "macOS interface: Built-in Voice readiness detail while the engine serves another mode. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing another engine task before Built-in Voice can be ready."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre tâche du moteur se termine avant que la voix intégrée soit prête."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminando otra tarea del motor antes de preparar Voz integrada."
          }
        },
