    "vocello.ui.installDetail": {
      "comment": "Onboarding explanation of separately downloaded models; Speed is the model-tier name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the 4-bit Speed model to start generating. Voice Design and Voice Cloning each have their own model; install them later in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez le modèle Speed 4 bits pour commencer. La création et le clonage de voix ont chacun leur propre modèle, à installer ensuite dans Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga el modelo Speed de 4 bits para empezar a generar. Diseño de voz y Clonación de voz tienen sus propios modelos; puedes instalarlos después en Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade das 4-Bit-Speed-Modell, um loszulegen. Stimmdesign und Stimmklonen haben jeweils ein eigenes Modell; installiere sie später in den Einstellungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica il modello Speed a 4 bit per iniziare. Design vocale e Clonazione vocale hanno ciascuno il proprio modello; potrai installarli in seguito in Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe o modelo Speed de 4 bits para começar. Criação de voz e Clonagem de voz têm seus próprios modelos; instale-os depois nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载 4 位 Speed 模型即可开始生成。声音设计和声音克隆各有独立模型，可稍后在设置中安装。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4ビットの Speed モデルをダウンロードして始めましょう。ボイスデザインとボイスクローンには専用モデルがあり、後で設定からインストールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4비트 Speed 모델을 다운로드해 시작하세요. 음성 디자인과 음성 복제는 각각 별도 모델이 있으며 나중에 설정에서 설치할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите 4-битную модель Speed, чтобы начать генерацию. Дизайн и клонирование голоса используют отдельные модели; их можно установить позже в настройках."
          }
        }
      }
    },
