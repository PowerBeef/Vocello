{
  "sourceLanguage": "en",
  "strings": {
    "vocello.settings.appLanguage": {
      "comment": "Language of the interface, not generated speech.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Language"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langue de l’app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma de la app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Sprache"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingua dell’app"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma do app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用语言"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの言語"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 언어"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык приложения"
          }
        }
      }
    },
    "vocello.settings.appLanguageDetail": {
      "comment": "Explains the separate interface language preference.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the app interface, not the language of generated speech."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie l’interface de l’app, pas la langue de la parole générée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la interfaz de la app, no el idioma de la voz generada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Sprache der Oberfläche, nicht die der erzeugten Sprache."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la lingua dell’interfaccia, non quella della voce generata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera a interface do app, não o idioma da fala gerada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改应用界面语言，不影响生成语音的语言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの表示言語を変更します。生成する音声の言語は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 인터페이스 언어를 바꿉니다. 생성되는 음성의 언어는 바뀌지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет язык интерфейса, а не генерируемой речи."
          }
        }
      }
    },
    "vocello.settings.systemLanguage": {
