{
  "schemaVersion": 2,
  "status": "active-experimental",
  "boundary": "Operator-local research. Automated review requires no human listening; qualified results support only their named measured claims. This contract cannot alter product instructions or become an ordinary CI prerequisite. Optional listener-labelled models retain their original provenance, not a required operational stage.",
  "hostClass": {
    "canonical": "Mac mini M6 16GB (mac-mini-m6-16gb)",
    "executionPolicy": "budgeted-admission-after-generator-exit",
    "admissionRegistry": "config/audio-qc-judges.json#admission",
    "orchestrator": "scripts/audio_qc_orchestrator.py",
    "provisionalMaximumProcessPeakRSSBytes": 5368709120,
    "ceilingIsProvisional": true,
    "requireNoMemoryPressureWarning": true,
    "requireNoMeaningfulSwapOutGrowth": true,
    "requirePostExitMemoryRecovery": true,
    "qualificationRuns": 2
  },
  "cache": {
    "root": "build/cache/delivery-analysis",
    "identityComponents": [
      "originalWAVSHA256",
      "canonicalDerivativeSHA256",
      "layerID",
      "layerVersion",
      "binarySHA256",
      "modelID",
      "modelRevision",
      "weightsSHA256",
      "preprocessingConfigDigest"
    ],
    "canonicalAudio": {
      "sampleRateHz": 16000,
      "channels": 1,
      "format": "pcm-s16le",
      "deterministicResampling": "polyphase-kaiser5-v2"
    },
    "atomicWrites": true,
    "failClosedOnDigestMismatch": true,
    "reportsMayContainLocalPaths": false
  },
  "temporalFeatures": {
    "schemaVersion": 1,
    "voicedContentRegions": 5,
    "boundedMemory": true,
    "pairedDeltaBlock": "temporalDeltaV1"
  },
  "humanCalibration": {
    "requiredForAutomatedReview": false,
    "schemaVersion": 2,
    "minimumIndependentListeners": 3,
    "minimumValidListenersPerRatedRow": 3,
    "minimumSpeakers": 6,
    "minimumScripts": 3,
    "minimumPresets": 8,
    "repeatFraction": 0.125,
    "minimumIntraRaterRepeatAgreement": 0.75,
    "minimumAnchorAccuracy": 0.8,
    "allowedRepeatFraction": {
      "minimum": 0.1,
      "maximum": 0.15
    },
    "perListenerIndependentOrder": true,
    "requireAnchors": true,
    "allowUncertain": true,
    "retainListenerLevelRows": true,
    "requestedLabelMayEnterDimensionalBlock": false,
    "humanSemanticAuthorityRequired": false
  },
  "evaluator": {
    "baseline": "ridge-v1",
    "pairwise": "per-preset-regularized-logistic-v2",
    "dimensionalChallengers": [
      "elastic-net-v2",
      "partial-least-squares-v2"
    ],
    "blockedValidationGroups": [
      "speakerID",
      "scriptTranslationGroup",
      "seed",
      "outputLanguage"
    ],
    "uncertainty": "blocked-split-conformal-v1",
    "outOfDistribution": [
      "robustMahalanobis",
      "nearestNeighborDistance",
      "perFeatureZ",
      "speakerNovelty",
      "languageNovelty"
    ],
    "challengerMustImproveUntouchedHoldout": true,
    "challengerMayRegressAnyVADDimension": false,
    "challengerMayRegressAnyPreset": false,
    "challengerMayRegressAnySpeaker": false,
    "challengerMayRegressAnyScriptGroup": false,
    "distributedSpeakerAndScriptGainRequired": true,
    "qcRole": "retired-from-qc",
    "qcRoleNote": "The fitted heads left every QC path on 2026-09-26 (AQ-05; registry judge delivery.fitted-heads@2): never calibrated, always abstaining. These fields bound the research fitting and scoring commands only."
  },
  "compactAdapters": {
    "contractFirst": true,
    "candidateOrder": [
      "sensevoice-small-q8"
    ],
    "adopted": [],
    "requiredBeforeExecution": [
      "registered-judge-tier-a-or-b",
      "commercially-compatible-license",
      "declared-training-data",
      "immutable-revision",
      "binary-sha256",
      "weights-sha256",
      "adapter-layer-sha256",
      "runtime-dependency-digest",
      "preprocessing-config-digest",
      "output-identity-digest",
      "envelope-identity-provenance",
      "offline-after-acquisition"
    ],
    "requiredBeforeAdoption": [
      "two-clean-canonical-host-runs",
      "clean-post-exit-memory-release",
      "untouched-independent-reference-holdout-improvement"
    ]
  },
  "cascade": {
    "always": [
      "audio-qc",
      "global-acoustics",
      "temporal-acoustics",
      "byte-bound-native-fast-qc",
      "independent-full-file-asr-evidence"
    ],
    "optionalQualifiedLayers": [
      "cached-compact-representation"
    ],
    "ambiguousOnly": [
      "coarse-ser-asr",
      "extra-identity"
    ],
    "finalistsOnly": [
      "complete-multilingual-asr-cer",
      "optional-semantic-reviewer",
      "automated-untouched-holdout"
    ]
  },
  "promotion": {
    "automaticLayersMayReject": true,
    "automaticLayersMayAbstain": true,
    "automaticLayersMayRouteToManualListening": false,
    "humanListeningRequired": false,
    "automaticLayersMayQualifyMeasuredClaims": true,
    "automaticLayersMayPromoteSemanticDelivery": false,
    "confirmationSelectorsForbidden": true,
    "requestedLabelsForbiddenFromBlindFeatureExtraction": true,
    "productionEmotionPresetChangesInThisWork": false
  },
  "acousticReferenceBase": {
    "manifest": "config/delivery-acoustic-reference-base.json",
    "sha256": "a3b0499e6987b0a71e3bf0860e279388ea03b73adb8b0ad6261b03647928bfed",
    "defaultComparison": "advisory",
    "requiredForRelease": false,
    "missingOrDrifted": "report-unavailable-without-changing-quality-route"
  }
}
