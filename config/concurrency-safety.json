{
  "schemaVersion": 1,
  "owner": "backend-runtime",
  "policy": "Every unchecked Sendable declaration in owned production Swift requires a registry entry, an explicit owner, a synchronization invariant, and deterministic evidence.",
  "sourceRoots": [
    "Sources",
    "Packages/VocelloQwen3Core/Sources"
  ],
  "unsafeDeclarations": [
    {
      "source": "Sources/QwenVoiceCore/HuggingFaceDownloader.swift",
      "names": [
        "foregroundTransferConfiguration",
        "session",
        "transferDelegateQueue"
      ],
      "owner": "downloader initializer and terminal invalidation",
      "invariant": "The URLSession reference, the retained foreground configuration, and the shared serial delegate queue are assigned once during init and never mutated; sessions (including lazily created per-worker chunk sessions behind a Mutex) are invalidated only after terminal processing."
    },
    {
      "source": "Sources/QwenVoiceCore/TelemetryGate.swift",
      "names": [
        "handshakeOverride",
        "handshakeMode"
      ],
      "owner": "TelemetryGate lock",
      "invariant": "All reads and writes occur while the process-local lock is held."
    },
    {
      "source": "Sources/QwenVoiceCore/NativeDeviceClassGate.swift",
      "names": [
        "handshakeForcedClass"
      ],
      "owner": "NativeDeviceClassGate lock",
      "invariant": "The handshake override is a lock-protected one-way latch."
    },
    {
      "source": "Sources/QwenVoiceCore/BenchForceColdPolicy.swift",
      "names": [
        "consumed"
      ],
      "owner": "BenchForceColdPolicy lock",
      "invariant": "The benchmark-only one-shot flag is read and written only while locked."
    },
    {
      "source": "Sources/VocelloCLI/Support.swift",
      "names": [
        "_verbosity"
      ],
      "owner": "CLIOutput lock",
      "invariant": "Verbosity is read and written only through the lock-protected property."
    },
    {
      "source": "Sources/iOS/TTSEngineStore.swift",
      "names": [
        "thermalObserverToken"
      ],
      "owner": "TTSEngineStore MainActor lifetime",
      "invariant": "The observer token is assigned once during MainActor initialization and read only during deinitialization."
    }
  ],
  "entries": [
