          }
        }
      }
    },
    "vocello.history.unqueued_detail": {
      "comment": "Warning that unqueued History identity is held only in app-session memory, not crash-safe storage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is still available. Retry saving or export it before quitting; recovery has not been safely queued."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio reste disponible. Réessayez de l’enregistrer ou exportez-le avant de quitter ; sa récupération n’a pas pu être mise en attente de manière durable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio sigue disponible. Reintenta guardarlo o expórtalo antes de salir; la recuperación no se ha puesto en cola de forma segura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio ist weiterhin verfügbar. Speichere es erneut oder exportiere es vor dem Beenden; die Wiederherstellung wurde nicht sicher eingereiht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio è ancora disponibile. Riprova a salvarlo o esportalo prima di uscire; il recupero non è stato accodato in sicurezza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio ainda está disponível. Tente salvar novamente ou exporte antes de sair; a recuperação não foi colocada na fila com segurança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频仍可用。请在退出前重试保存或导出；恢复任务尚未安全加入队列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はまだ利用できます。終了前に保存を再試行するか書き出してください。復旧は安全にキューへ登録されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오는 아직 사용할 수 있습니다. 종료 전에 저장을 재시도하거나 내보내세요. 복구 작업이 안전하게 대기열에 등록되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио всё ещё доступно. До выхода повторите сохранение или экспортируйте его; восстановление не поставлено в очередь безопасно."
          }
        }
      }
    },
    "vocello.history.retry_save": {
      "comment": "Retries storage only, never speech generation.",
      "extractionState": "manual",
      "localizations": {
