    "vocello.mac.custom.speakerNativeLanguageHint": {
      "comment": "macOS interface: hint under the language picker; %1$@ speaker name, %2$@ native language, %3$@ selected language. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is native to %2$@. %3$@ can still work, but pronunciation is usually best in the speaker's native language."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est une voix native en %2$@. %3$@ peut fonctionner, mais la prononciation est généralement meilleure dans la langue native du locuteur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tiene %2$@ como idioma nativo. %3$@ también puede funcionar, pero la pronunciación suele ser mejor en el idioma nativo de la voz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ spricht muttersprachlich %2$@. %3$@ kann ebenfalls funktionieren, die Aussprache ist aber meist in der Muttersprache am besten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua madre di %1$@ è %2$@. Anche %3$@ può funzionare, ma la pronuncia è solitamente migliore nella lingua madre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tem %2$@ como idioma nativo. %3$@ também pode funcionar, mas a pronúncia costuma ser melhor no idioma nativo da voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的母语是 %2$@。%3$@ 也可使用，但通常用说话者的母语发音更好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の母語は %2$@ です。%3$@ も使えますが、通常は母語の発音が最も自然です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 모국어는 %2$@입니다. %3$@도 가능하지만 보통 모국어에서 발음이 가장 좋습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Родной язык %1$@ — %2$@. %3$@ тоже может работать, но произношение обычно лучше на родном языке диктора."
          }
        }
      }
    },
    "vocello.mac.custom.deliveryUnsupported": {
