      "design": {
        "dimensions": {
          "brief": ["starter", "custom"],
          "delivery": ["neutral", "happy", "sad", "angry", "fearful", "surprised", "calm", "whisper"],
          "language": ["english", "chinese", "japanese", "korean", "german", "french", "russian", "portuguese", "spanish", "italian"],
          "variation": ["expressive", "balanced", "consistent"],
          "length": ["short", "long"]
