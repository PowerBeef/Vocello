    "emozionalmente": {
      "alsoIn": [],
      "attribution": "Emozionalmente: a crowdsourced corpus of simulated emotional speech in Italian (F. Catania, J. W. Wilke and F. Garzotto, IEEE Transactions on Audio, Speech and Language Processing 33, 2025, doi:10.1109/TASLPRO.2025.3540662), Zenodo record 12616095 version 1.1, under the Creative Commons Attribution 4.0 International license (CC BY 4.0). No audio or label is redistributed or committed.",
      "caveats": [
        "431 amateur actors recorded on non-professional equipment; each clip's emotion is the actor's intended emotion, not a perceived one.",
        "Pinned by Zenodo's MD5 and size; the SHA-256 is recorded on the first verified fetch.",
        "The archive carries macOS __MACOSX entries, which are ignored."
      ],
      "extract": {
        "estimateBasis": "6,902 clips of 3.81 s on average (the Zenodo record) of 16 kHz PCM16",
        "estimatedBytes": 841491840,
        "format": "zip",
        "ignore": [
          "^__MACOSX/",
          "(^|/)\\._"
        ],
        "maps": {
