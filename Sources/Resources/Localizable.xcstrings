            "state": "translated",
            "value": "La transcription sur l’appareil n’est pas disponible. Saisissez une transcription ou utilisez l’audio seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción local no está disponible. Introduce una transcripción o usa solo audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Transkription ist nicht verfügbar. Gib ein Transkript ein oder verwende nur Audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione sul dispositivo non disponibile. Inserisci una trascrizione o usa solo l’audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrição no dispositivo indisponível. Digite uma transcrição ou use somente áudio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端转录不可用。请输入转录文本或仅使用音频。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上の文字起こしを利用できません。入力するか、音声のみを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 받아쓰기를 사용할 수 없습니다. 녹취록을 입력하거나 오디오만 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка на устройстве недоступна. Введите текст или используйте только аудио."
          }
        }
      }
    },
    "vocello.enrollment.use_audio_only": {
