    "vocello.mac.savedVoice.replaceSubtitle": {
      "comment": "macOS interface: subtitle of the replace-reference sheet. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a longer, cleaner clip (10–20 seconds works best). The existing reference will be replaced after the new one saves successfully."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un extrait plus long et plus propre (10 à 20 secondes idéalement). La référence existante sera remplacée une fois la nouvelle enregistrée avec succès."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un clip más largo y limpio (10–20 segundos es lo ideal). La referencia actual se reemplazará cuando se guarde la nueva correctamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen längeren, klareren Clip (am besten 10–20 Sekunden). Die vorhandene Referenz wird erst nach erfolgreichem Speichern der neuen ersetzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un clip più lungo e pulito (10–20 secondi è l’ideale). Il riferimento esistente sarà sostituito solo dopo il salvataggio riuscito del nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um clipe mais longo e limpo (10–20 segundos funciona melhor). A referência atual será substituída após o novo clipe ser salvo com sucesso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择更长、更清晰的音频（10–20 秒最佳）。新参考成功保存后才会替换现有参考。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より長く明瞭な音声を選んでください（10〜20秒が最適です）。新しい参照音声の保存に成功した後で既存のものを置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 길고 깨끗한 오디오를 선택하세요(10–20초 권장). 새 참조를 성공적으로 저장한 뒤 기존 참조를 바꿉니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите более длинную и чистую запись (лучше 10–20 секунд). Текущий образец будет заменён только после успешного сохранения нового."
          }
        }
      }
    },
