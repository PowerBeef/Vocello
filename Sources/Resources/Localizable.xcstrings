    "vocello.mac.record.noMicrophone": {
      "comment": "macOS interface: record sheet status without an input device. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone detected. Connect a microphone or audio-input device to record."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun microphone détecté. Branchez un microphone ou un périphérique d’entrée audio pour enregistrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectó ningún micrófono. Conecta un micrófono o dispositivo de entrada de audio para grabar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Mikrofon erkannt. Schließe zum Aufnehmen ein Mikrofon oder Audioeingabegerät an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun microfono rilevato. Collega un microfono o un dispositivo di ingresso audio per registrare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum microfone detectado. Conecte um microfone ou dispositivo de entrada de áudio para gravar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到麦克风。请连接麦克风或音频输入设备以录音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが見つかりません。録音にはマイクまたは音声入力デバイスを接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 찾지 못했습니다. 녹음하려면 마이크나 오디오 입력 기기를 연결하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон не найден. Для записи подключите микрофон или устройство аудиоввода."
          }
        }
      }
    },
    "vocello.mac.record.microphoneDenied": {
      "comment": "macOS interface: record sheet status when microphone permission is denied. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is denied. Enable it in System Settings to record."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au microphone est refusé. Activez-le dans Réglages Système pour enregistrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono está denegado. Actívalo en Ajustes del Sistema para grabar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonzugriff verweigert. Aktiviere ihn zum Aufnehmen in den Systemeinstellungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso al microfono negato. Abilitalo in Impostazioni di Sistema per registrare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso ao microfone negado. Ative-o nos Ajustes do Sistema para gravar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风访问被拒绝。请在系统设置中启用以录音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスが拒否されています。録音するにはシステム設定で有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근이 거부되었습니다. 녹음하려면 시스템 설정에서 활성화하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону запрещён. Включите его в Системных настройках для записи."
          }
        }
      }
    },
    "vocello.mac.record.failedToStart": {
      "comment": "macOS interface: record sheet status when the recorder failed to start. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording couldn't start. Check your microphone in System Settings → Sound, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement n’a pas pu démarrer. Vérifiez votre microphone dans Réglages Système → Son, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la grabación. Comprueba el micrófono en Ajustes del Sistema → Sonido y reinténtalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme konnte nicht starten. Prüfe dein Mikrofon unter Systemeinstellungen → Ton und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la registrazione. Controlla il microfono in Impostazioni di Sistema → Suono, poi riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a gravação. Verifique o microfone em Ajustes do Sistema → Som e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始录音。请在“系统设置 → 声音”中检查麦克风，然后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を開始できませんでした。「システム設定 → サウンド」でマイクを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 시작하지 못했습니다. 시스템 설정 → 사운드에서 마이크를 확인한 뒤 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать запись. Проверьте микрофон в «Системные настройки → Звук» и повторите попытку."
          }
        }
      }
    },
    "vocello.mac.record.idleHint": {
      "comment": "macOS interface: record sheet instructions before recording. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Record, then read 10–20 s of clean, natural speech. Quiet room. One voice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Enregistrer, puis lisez 10 à 20 s de parole naturelle et propre. Pièce calme. Une seule voix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Grabar y lee de 10 a 20 s con voz clara y natural. En un lugar silencioso. Una sola voz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf Aufnehmen und sprich 10–20 s klar und natürlich. Ruhiger Raum. Eine Stimme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su Registra e leggi per 10–20 s con voce chiara e naturale. Stanza silenziosa. Una sola voce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em Gravar e leia por 10–20 s com fala clara e natural. Ambiente silencioso. Uma voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“录音”，在安静环境中用单一声音清晰自然地朗读 10–20 秒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音をクリックし、静かな場所で1人の声で10〜20秒、自然にはっきり読んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 클릭하고 조용한 곳에서 한 사람의 목소리로 10–20초 동안 자연스럽고 또렷하게 읽으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Записать» и читайте 10–20 с чётко и естественно. Тихая комната. Один голос."
          }
        }
      }
    },
    "vocello.mac.record.keepGoing": {
      "comment": "macOS interface: record sheet status under the minimum duration. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep recording. 10 second minimum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez l’enregistrement. 10 secondes minimum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue grabando. Mínimo 10 segundos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter aufnehmen. Mindestens 10 Sekunden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a registrare. Minimo 10 secondi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue gravando. Mínimo de 10 segundos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请继续录制，至少需要 10 秒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を続けてください。最低10秒必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 녹음하세요. 최소 10초가 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте запись. Минимум 10 секунд."
          }
        }
      }
    },
    "vocello.mac.record.soundsGood": {
      "comment": "macOS interface: record sheet status within the recommended duration. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds good. Click Stop when ready."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça sonne bien. Cliquez sur Arrêter quand vous êtes prêt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buena duración. Haz clic en Detener cuando termines."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gute Länge. Klicke auf Stopp, wenn du fertig bist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durata corretta. Fai clic su Stop quando hai finito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Boa duração. Clique em Parar quando terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时长合适。完成后点击“停止”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適切な長さです。準備ができたら停止をクリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적절한 길이입니다. 준비되면 중지를 클릭하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходящая длина. Нажмите «Стоп», когда закончите."
          }
        }
      }
    },
    "vocello.mac.record.overLimit": {
      "comment": "macOS interface: record sheet status over the recommended duration. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 20 seconds. Stop now."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de 20 secondes. Arrêtez maintenant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más de 20 segundos. Detén la grabación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über 20 Sekunden. Jetzt stoppen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oltre 20 secondi. Ferma la registrazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais de 20 segundos. Pare agora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
