    "vocello.ui.qualityIntro": {
      "comment": "iOS display-only qualityIntro; preserve model IDs, prompt text and warning policy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice cloning works best with 10–20 seconds of clean speech."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clonage vocal fonctionne mieux avec 10 à 20 secondes de parole claire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clonación funciona mejor con 10–20 segundos de voz clara."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmklonen funktioniert am besten mit 10–20 Sekunden klarer Sprache."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La clonazione funziona al meglio con 10–20 secondi di parlato pulito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A clonagem funciona melhor com 10–20 segundos de fala limpa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音克隆最适合使用 10–20 秒的清晰语音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボイスクローンには、はっきりした10〜20秒の話し声が最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 복제는 10–20초의 깨끗한 말소리에서 가장 잘 작동합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для клонирования лучше всего подходят 10–20 секунд чистой речи."
          }
        }
      }
    },
    "vocello.ui.qualityHard": {
      "comment": "iOS display-only qualityHard; preserve model IDs, prompt text and warning policy.",
      "extractionState": "manual",
      "localizations": {
