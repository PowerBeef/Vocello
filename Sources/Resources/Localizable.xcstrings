    "vocello.settings.refinement.cloneDisclosure": {
      "comment": "Settings refinement: preserve consent, free functionality and product meaning. No placeholder prices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you publish audio of a cloned real voice, disclose that it is AI-generated. EU law may require this."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous publiez l’audio d’une voix réelle clonée, indiquez qu’il est généré par IA. Le droit de l’UE peut l’exiger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si publicas audio de una voz real clonada, indica que se ha generado con IA. La legislación de la UE puede exigirlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Audio einer geklonten echten Stimme veröffentlichst, kennzeichne es als KI-generiert. EU-Recht kann dies verlangen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pubblichi audio di una voce reale clonata, dichiara che è generato dall’IA. La normativa UE potrebbe richiederlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se publicar áudio de uma voz real clonada, informe que foi gerado por IA. A legislação da UE pode exigir isso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果发布克隆真实声音的音频，请披露其由 AI 生成。欧盟法律可能有此要求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実在する声のクローン音声を公開する場合は、AI 生成であることを明示してください。EU 法で義務付けられる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 사람의 목소리를 복제한 오디오를 공개할 경우 AI로 생성했음을 알리세요. EU 법률에서 요구할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публикуя аудио клонированного реального голоса, укажите, что оно создано ИИ. Этого может требовать законодательство ЕС."
          }
        }
      }
    },
    "vocello.settings.refinement.cloneDisclosureHint": {
      "comment": "Settings refinement: preserve consent, free functionality and product meaning. No placeholder prices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-generated audio disclosure. If you publish audio of a cloned real voice, disclose that it is AI-generated. EU law may require this."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mention de l’audio généré par IA. Si vous publiez l’audio d’une voix réelle clonée, indiquez qu’il est généré par IA. Le droit de l’UE peut l’exiger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de audio generado con IA. Si publicas audio de una voz real clonada, indica que se ha generado con IA. La legislación de la UE puede exigirlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kennzeichnung KI-generierter Audios. Wenn du Audio einer geklonten echten Stimme veröffentlichst, kennzeichne es als KI-generiert. EU-Recht kann dies verlangen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dichiarazione di audio generato dall’IA. Se pubblichi audio di una voce reale clonata, dichiara che è generato dall’IA. La normativa UE potrebbe richiederlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de áudio gerado por IA. Se publicar áudio de uma voz real clonada, informe que foi gerado por IA. A legislação da UE pode exigir isso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 生成音频披露。如果发布克隆真实声音的音频，请披露其由 AI 生成。欧盟法律可能有此要求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 生成音声の明示。実在する声のクローン音声を公開する場合は、AI 生成であることを明示してください。EU 法で義務付けられる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 생성 오디오 고지. 실제 사람의 목소리를 복제한 오디오를 공개할 경우 AI로 생성했음을 알리세요. EU 법률에서 요구할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Указание на аудио, созданное ИИ. Публикуя аудио клонированного реального голоса, укажите, что оно создано ИИ. Этого может требовать законодательство ЕС."
          }
        }
      }
    },
