{
  "sourceLanguage": "en",
  "strings": {
    "vocello.settings.appLanguage": {
      "comment": "Language of the interface, not generated speech.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Language"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langue de l’app"
          }
        }
      }
    },
    "vocello.settings.appLanguageDetail": {
      "comment": "Explains the separate interface language preference.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the app interface, not the language of generated speech."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie l’interface de l’app, pas la langue de la parole générée."
          }
        }
      }
    },
    "vocello.settings.systemLanguage": {
      "comment": "Follow the operating system's preferred app language.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Default"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglage du système"
          }
        }
      }
    },
    "vocello.ui.seed": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Graine"
          }
        }
      }
    },
    "vocello.ui.unpinSeed": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpin — new seed each take"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désépingler — nouvelle graine à chaque prise"
          }
        }
      }
    },
    "vocello.ui.keepPinned": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep pinned"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder épinglée"
          }
        }
      }
    },
    "vocello.ui.stopGenerating": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop generating"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la génération"
          }
        }
      }
    },
    "vocello.ui.unusualPacing": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unusual pacing detected"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rythme inhabituel détecté"
          }
        }
      }
    },
    "vocello.ui.reviewTake": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review this take or generate it again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez cette prise ou générez-la à nouveau."
          }
        }
      }
    },
    "vocello.ui.timingAdvisory": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing requests aren’t honored — the voice can’t target a duration, so this may distort pacing instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes de durée ne sont pas respectées : la voix ne peut pas viser une durée précise, ce qui risque de déformer le rythme."
          }
        }
      }
    },
    "vocello.ui.tonePlaceholderCalm": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. A calm narrator, warm and measured"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : une narration calme, chaleureuse et posée"
          }
        }
      }
    },
    "vocello.ui.tonePlaceholderNews": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. An energetic news anchor, bright and fast"
