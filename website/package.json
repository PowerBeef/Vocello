{
  "name": "vocello-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "node scripts/site-contract.mjs && eslint . && tsc -p jsconfig.json",
    "test": "node --test tests/*.test.mjs && node scripts/rendered-contract.mjs",
    "build": "vite build && vite build --ssr src/entry-ssr.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "check": "npm run lint && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  }
}
