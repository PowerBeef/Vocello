    "vocello.ui.unpinSeed": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpin — new seed each take"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désépingler — nouvelle graine à chaque prise"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfijar: nueva semilla en cada toma"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösen – neuer Startwert je Aufnahme"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca: nuovo seed a ogni take"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desafixar — nova semente a cada tomada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消固定，每次使用新种子"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定を解除 — 毎回新しいシードを使用"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정 해제 — 매번 새 시드 사용"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открепить — новое зерно для каждого дубля"
          }
        }
      }
    },
