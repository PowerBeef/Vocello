    "vocello.mac.record.microphoneDeniedDetail": {
      "comment": "macOS interface: recorder alert body when the microphone permission is denied. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello needs the microphone to record reference clips. Enable it in System Settings to continue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello a besoin du microphone pour enregistrer des clips de référence. Activez-le dans les Réglages Système pour continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello necesita el micrófono para grabar clips de referencia. Actívalo en Ajustes del Sistema para continuar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello benötigt das Mikrofon für Referenzaufnahmen. Aktiviere es in den Systemeinstellungen, um fortzufahren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello richiede il microfono per registrare riferimenti. Abilitalo in Impostazioni di Sistema per continuare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vocello precisa do microfone para gravar referências. Ative-o nos Ajustes do Sistema para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello 需要麦克风来录制参考音频。请在系统设置中启用以继续。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照音声の録音にはマイクが必要です。続けるにはシステム設定で有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참조 오디오를 녹음하려면 마이크가 필요합니다. 계속하려면 시스템 설정에서 활성화하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello нужен микрофон для записи образцов. Включите его в Системных настройках, чтобы продолжить."
          }
        }
      }
    },
