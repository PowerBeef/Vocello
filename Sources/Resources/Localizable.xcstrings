          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Génération"
          }
        }
      }
    },
    "vocello.mac.settings.preferLowerMemory": {
      "comment": "macOS interface: Settings toggle title. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer lower-memory models"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préférer les modèles moins gourmands en mémoire"
          }
        }
      }
    },
    "vocello.mac.settings.preferLowerMemoryDetail": {
      "comment": "macOS interface: Settings toggle detail. Speed and Quality are package tier names. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pins every generation mode to the Speed package. Speed uses less memory and is safer on lower-RAM Macs, with lower fidelity than Quality. You can still switch per-generation in the mode screens; this toggle just changes the defaults."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe chaque mode de génération sur le paquet Rapide. Rapide utilise moins de mémoire et convient mieux aux Mac avec peu de RAM, avec une fidélité moindre que Qualité. Vous pouvez toujours changer par génération dans les écrans de mode ; ce réglage ne modifie que les valeurs par défaut."
          }
        }
      }
    },
    "vocello.mac.settings.performance": {
