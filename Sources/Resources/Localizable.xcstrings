    "vocello.settings.polish.modelsDetail": {
      "comment": "Settings polish; localized display only. Preserve placeholders and stored model/variation identities.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One private, on-device model powers each Studio mode. Install only the modes you use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mode du Studio utilise un modèle privé sur votre appareil. Installez uniquement les modes que vous utilisez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modo de Studio usa su propio modelo privado en el dispositivo. Instala solo los modos que utilices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Studio-Modus nutzt ein eigenes privates Modell auf dem Gerät. Installiere nur die benötigten Modi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni modalità di Studio usa un modello privato sul dispositivo. Installa solo le modalità che usi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modo do Studio usa seu próprio modelo privado no dispositivo. Instale apenas os modos que você usa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种 Studio 模式都使用独立的设备端私有模型。只需安装你使用的模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio の各モードは、専用の非公開モデルをデバイス上で使用します。使うモードだけをインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 Studio 모드는 기기 내 전용 비공개 모델을 사용합니다. 사용하는 모드만 설치하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый режим Studio использует отдельную приватную модель на устройстве. Устанавливайте только нужные режимы."
          }
        }
      }
    },
