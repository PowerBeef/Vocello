    "vocello.mac.cloning.transcriptHelp": {
      "comment": "macOS interface: tooltip of the Voice Cloning transcript field. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best quality uses reference audio plus an accurate transcript. Audio-only cloning remains available as a lower-guidance fallback."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La meilleure qualité combine l’audio de référence et une transcription exacte. Le clonage audio seulement reste disponible comme repli moins guidé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mejor calidad se consigue con audio de referencia y una transcripción precisa. La clonación con solo audio sigue disponible como alternativa con menos orientación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste Qualität erfordert Referenzaudio und ein genaues Transkript. Klonen nur mit Audio bleibt als weniger stark geführte Ausweichlösung verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La qualità migliore richiede audio di riferimento e una trascrizione precisa. La clonazione solo audio resta disponibile come alternativa con meno indicazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A melhor qualidade usa áudio de referência e transcrição precisa. A clonagem somente com áudio continua disponível como alternativa com menos orientação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考音频加准确转录可获得最佳质量。仅音频克隆仍可作为引导较少的备用方式使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照音声と正確な文字起こしを使うと最高の品質になります。音声のみのクローンも、誘導の少ない代替方式として利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참조 오디오와 정확한 녹취록을 함께 사용하면 품질이 가장 좋습니다. 오디오만 사용하는 복제도 지침이 적은 대체 방식으로 가능합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшее качество даёт образец аудио с точной расшифровкой. Клонирование только по аудио остаётся запасным вариантом с меньшим управлением."
          }
        }
      }
    },
    "vocello.mac.cloning.consentOneTime": {
      "comment": "macOS interface: note under the inline cloning consent. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time acknowledgment. Review it anytime in Settings."
          }
        },
        "fr": {
          "stringUnit": {
