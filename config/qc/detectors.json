{
  "schemaVersion": 1,
  "version": 5,
  "models": {
    "asrA": "asr.qwen3-asr-1.7b",
    "asrB": "asr.whisper-large-v3",
    "phones": "phones.zipa-large-crctc-500k",
    "phonesB": "phones.wav2vec2-xlsr-53-espeak-cv-ft",
    "g2p": "g2p.espeak-ng",
    "pitchA": "pitch.fcpe",
    "pitchB": "pitch.swiftf0",
    "speaker": "speaker.redimnet2-plus"
  },
  "params": {
    "gopLow": -2.3,
    "loudnessTarget": -23.0,
    "excerptMinGapSeconds": 0.4,
    "excerptEdgeSeconds": 0.04,
    "excerptPhoneMinProb": 0.5,
    "excerptIgnorePhones": ["h", "ɦ"],
    "pitchAgreeCents": 50,
    "silenceAmplitude": 0.0005,
    "clickSigma": 12.0
  },
  "fit": {
    "l2": 1.0,
    "perLanguageMinClean": 60,
    "perLanguageMinPositive": 20,
    "positiveMinSeverity": "moderate",
    "pooledMinPositive": 10,
    "crossValidationFolds": 5
  },
  "levels": {
    "warn": {"precisionLower": 0.6, "recall": 0.6},
    "fail": {"precisionLower": 0.8, "cleanFalseAlarmUpper": 0.05},
    "humanReference": {"warnFalseAlarmRate": 0.02, "warnFalseAlarmUpper": 0.06, "failMinConfirmed": 17}
  },
  "lanes": {
    "language-bench": {
      "description": "scripts/macos_test.sh lang-bench: the language matrix's takes from the Mac CLI. asrA and asrB are the two spoken-content families of the language record (scripts/qc/language.py).",
      "models": ["asrA", "asrB", "g2p", "phones", "phonesB"]
    },
    "ios-language-bench": {
      "description": "scripts/ios_device.sh lang-bench: the iPhone's takes, scored on the Mac once they are collected.",
      "models": ["asrA", "asrB", "g2p", "phones", "phonesB"]
    },
    "qc-takes": {
      "description": "scripts/macos_test.sh qc-takes: the take pool after generation, then the listening queue.",
      "models": ["asrA", "asrB", "g2p", "phones", "phonesB"]
    },
    "controls": {
      "description": "qc.py controls build: human read speech, scored with the qc-takes roles; every flag is report-only.",
      "models": ["asrA", "asrB", "g2p", "phones", "phonesB"]
    },
    "clone-lane": {
      "description": "scripts/clone_fidelity_lane.py: fixed-seed clone takes against their reference clip (identity and pitch); its controls are scored against the same clip and never gate.",
      "models": ["speaker", "pitchA", "pitchB"]
    },
    "voice-reliability": {
      "description": "scripts/voice_identity_language_reliability.py analyze: Clone takes against their reference clip; reported, never gated.",
      "models": ["speaker", "pitchA", "pitchB"]
    }
  },
  "detectors": [
    {"id": "pause.anomalous", "class": "pause", "method": "logistic", "features": [
      {"name": "pause.longest_gap_seconds", "direction": "higher"},
      {"name": "pause.nonspeech_level_db", "direction": "higher"},
      {"name": "pause.voiced_blips", "direction": "higher"},
      {"name": "pause.excerpt_phones", "direction": "lower"}],
     "provisional": {"all": [{"feature": "pause.longest_gap_seconds", "op": ">", "value": 0.5, "norm": "p99", "normFeature": "pause.gap_seconds", "atLeast": 0.5}],
                     "none": [{"feature": "pause.excerpt_phones", "op": ">", "value": 0}]}},
    {"id": "level.loudness", "class": null, "advisory": true, "method": "logistic", "features": [
      {"name": "level.lufs_deviation", "direction": "higher"},
      {"name": "level.true_peak_dbtp", "direction": "higher"},
      {"name": "level.lufs", "direction": "lower"}],
     "provisional": {"any": [{"feature": "level.lufs_deviation", "op": ">", "value": 4},
                             {"feature": "level.true_peak_dbtp", "op": ">", "value": -1}]}},
    {"id": "content.phoneme", "class": "stutter", "method": "logistic", "features": [
      {"name": "phones.deletion_rate", "direction": "higher"},
      {"name": "phones.repeat_runs", "direction": "higher"},
      {"name": "phones.low_gop_run", "direction": "higher"},
      {"name": "phones.insertion_rate", "direction": "higher"}],
     "provisional": {"any": [{"feature": "phones.repeat_runs", "op": ">=", "value": 2},
                             {"feature": "phones.insertion_rate", "op": ">=", "value": 0.2}]}},
    {"id": "content.asr", "class": "stutter", "method": "logistic", "features": [
      {"name": "asr.phonetic_error_min", "direction": "higher"},
      {"name": "asr.edit_rate_min", "direction": "higher"}]},
    {"id": "boundary.cutoff", "class": "cutoff", "method": "logistic", "features": [
      {"name": "phones.last_word_coverage", "direction": "lower"},
      {"name": "signal.abrupt_offset_db", "direction": "higher"},
      {"name": "engine.finish_not_eos", "direction": "higher"}]},
    {"id": "language.wrong", "class": "wrong-language", "method": "logistic", "features": [
      {"name": "asr.language_mismatch_min", "direction": "higher"},
      {"name": "asr.script_mismatch_min", "direction": "higher"}]},
    {"id": "prosody.rate", "class": "unnatural", "method": "logistic", "features": [
      {"name": "rate.phones_per_second", "direction": "higher"},
      {"name": "rate.seconds_per_phone", "direction": "higher"}],
     "provisional": {"any": [{"feature": "rate.phones_per_second", "op": "<", "norm": "p1"},
                             {"feature": "rate.phones_per_second", "op": ">", "norm": "p99"}]}},
    {"id": "signal.artifacts", "class": "artifact", "method": "logistic", "features": [
      {"name": "signal.dropout_seconds", "direction": "higher"},
      {"name": "signal.clipping_fraction", "direction": "higher"},
      {"name": "signal.terminal_silence_seconds", "direction": "higher"}]},
    {"id": "prosody.pitch", "class": "pitch", "method": "logistic", "gateLanes": ["clone-lane"], "features": [
      {"name": "pitch.sustained_shift_st", "direction": "higher"},
      {"name": "pitch.octave_jumps", "direction": "higher"},
      {"name": "pitch.register_offset_st", "direction": "higher"},
      {"name": "pitch.tracker_disagreement", "direction": "higher"}]},
    {"id": "identity.drift", "class": "voice-change", "method": "logistic", "gateLanes": ["clone-lane"], "features": [
      {"name": "speaker.max_window_distance", "direction": "higher"},
      {"name": "speaker.whole_distance", "direction": "higher"},
      {"name": "speaker.window_range", "direction": "higher"}]}
  ]
}
