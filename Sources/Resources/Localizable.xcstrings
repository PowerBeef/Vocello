    "vocello.settings.refinement.cloneConsent": {
      "comment": "Settings refinement: preserve consent, free functionality and product meaning. No placeholder prices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I own or have permission to clone the voices I use"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je possède les voix que j’utilise ou j’ai l’autorisation de les cloner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soy titular de las voces que uso o tengo permiso para clonarlas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich besitze die verwendeten Stimmen oder darf sie klonen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possiedo le voci che uso o ho il permesso di clonarle"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sou dono das vozes que uso ou tenho permissão para cloná-las"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我拥有所用声音，或已获得克隆许可"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用する声を所有しているか、クローンの許可を得ています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하는 음성을 소유하고 있거나 복제 허가를 받았습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я владею используемыми голосами или имею разрешение на их клонирование"
          }
        }
      }
    },
