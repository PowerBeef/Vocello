    "vocello.mac.engine.coldStartLowMemory": {
      "comment": "macOS interface: readiness detail on 8 GB Macs when the model is unloaded. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model unloaded to save memory. First generate reloads it — normal on 8 GB Macs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle déchargé pour économiser la mémoire. La première génération le recharge — normal sur les Mac 8 Go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha descargado el modelo de la memoria para ahorrar espacio. Se volverá a cargar al generar; es normal en Macs con 8 GB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell zur Speicherersparnis entladen. Beim nächsten Erzeugen wird es neu geladen – auf Macs mit 8 GB normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello rimosso dalla memoria per risparmiarla. Verrà ricaricato alla prima generazione: è normale sui Mac da 8 GB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo removido da memória para economizá-la. A primeira geração o recarrega — normal em Macs com 8 GB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为节省内存，模型已卸载。首次生成会重新载入，在 8 GB Mac 上属正常情况。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ節約のためモデルを解放しました。最初の生成時に再読み込みします。8 GB の Mac では通常の動作です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리를 아끼기 위해 모델을 내렸습니다. 첫 생성 시 다시 불러옵니다. 8 GB Mac에서는 정상 동작입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель выгружена для экономии памяти. При первой генерации она загрузится заново — это нормально для Mac с 8 ГБ."
          }
        }
      }
    },
    "vocello.mac.engine.coldStart": {
      "comment": "macOS interface: readiness detail when the model is unloaded. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
