{
  "$id": "https://vocello.local/schemas/benchmark-history-v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Benchmark history record, schema v3: v2 plus the typed quality-registry identity on every generation take (phase 13). The executable validator in scripts/benchmark_history.py remains the authority; this contract bounds structure and vocabulary.",
  "properties": {
    "cells": {
      "items": {
        "$ref": "#/$defs/cell"
      },
      "type": "array"
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "hardware": {
      "$ref": "#/$defs/hardware"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "listening": {
      "$ref": "#/$defs/listening"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/model"
      },
      "type": "array"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "schemaVersion": {
      "const": 3
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "takes": {
      "items": {
        "$ref": "#/$defs/take"
      },
      "type": "array"
    },
    "toolchain": {
      "$ref": "#/$defs/toolchain"
    }
  },
  "required": [
    "schemaVersion",
    "run",
    "hardware",
    "source",
    "toolchain",
    "inputs",
    "models",
    "evidence",
    "takes",
    "cells",
    "comparison",
    "listening",
    "digest"
  ],
  "title": "Vocello benchmark history record v3",
  "type": "object",
  "$defs": {
    "cell": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "length": {
          "type": "string"
        },
        "maximumTrimLevel": {
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "type": "string"
        },
        "modelID": {
          "type": "string"
        },
        "statistics": {
          "type": "object"
        },
        "status": {
          "enum": [
            "passed",
            "passedWithWarnings"
          ]
        },
        "variant": {
          "type": "string"
        },
        "warningCount": {
          "minimum": 0,
          "type": "integer"
        },
        "warmState": {
          "type": "string"
        },
        "worstQCVerdict": {
          "enum": [
            "pass",
            "warn"
          ]
        },
        "worstThermalState": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "mode",
        "modelID",
        "variant",
        "warmState",
        "length",
        "count",
        "status",
        "statistics",
        "worstQCVerdict",
        "worstThermalState",
        "maximumTrimLevel",
        "warningCount"
      ],
      "type": "object"
    },
    "comparison": {
      "additionalProperties": false,
      "properties": {
        "baselineRunID": {
          "type": [
            "string",
            "null"
          ]
        },
        "comparable": {
          "type": "boolean"
        },
        "deltas": {
          "type": "object"
        },
        "key": {
          "$ref": "#/$defs/digest"
        },
        "deltaMetrics": {
          "enum": [
            "trend-v1"
          ]
        }
      },
      "required": [
        "key",
        "comparable",
        "baselineRunID",
        "deltas"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "actualTakeCount": {
          "minimum": 0,
          "type": "integer"
        },
        "crashCount": {
          "const": 0
        },
        "crashDeltaPassed": {
          "const": true
        },
        "expectedTakeCount": {
          "minimum": 0,
          "type": "integer"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "qcAlgorithmVersion": {
          "type": [
            "integer",
            "string"
          ]
        },
        "rawTelemetryDigest": {
          "type": "string"
        },
        "resultBundleDigest": {
          "type": "string"
        },
        "selectedEvidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "screenshotDigests": {
          "items": {
            "$ref": "#/$defs/screenshotDigest"
          },
          "type": "array"
        },
        "telemetrySchemaVersion": {
          "type": [
            "integer",
            "string"
          ]
        },
        "languageVerification": {
          "additionalProperties": false,
          "properties": {
            "outputSchemaVersion": {
              "enum": [
                3,
                1
              ]
            },
            "outputAlgorithm": {
              "enum": [
                "language-output-verifier-v3",
                "independent-asr-output-v1"
              ]
            },
            "recognitionSchemaVersion": {
              "enum": [
                2,
                1
              ]
            },
            "recognitionAlgorithm": {
              "enum": [
                "apple-speech-file-consensus-v2",
                "mlx-whisper-locked-decode-v1"
              ]
            },
            "accuracyMetricVersion": {
              "const": "normalized-edit-rate-v1"
            },
            "requiredPassCount": {
              "enum": [
                3,
                1
              ]
            },
            "hintCellsPassed": {
              "type": "integer",
              "minimum": 0
            },
            "hintCellsExpected": {
              "type": "integer",
              "minimum": 0
            },
            "outputCellsPassed": {
              "type": "integer",
              "minimum": 0
            },
            "outputCellsExpected": {
              "type": "integer",
              "minimum": 0
            },
            "negativeControlsConfirmed": {
              "type": "integer",
              "minimum": 0
            },
            "families": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "apple-speech",
                  "whisper",
                  "sensevoice"
                ]
              }
            },
            "independentRecognitionAlgorithm": {
              "const": "mlx-whisper-locked-decode-v1"
            },
            "independentModelIdentitySHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "languageCheckKinds": {
              "description": "Records since 2026-09-25: what each cited family's language check observes (apple-speech: transcript-language consistency on its locked transcript; whisper: audio language identification).",
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "trace": {
          "$ref": "#/$defs/trace"
        },
        "validatorPassed": {
          "const": true
        },
        "validatorSchemaVersion": {
          "type": [
            "integer",
            "string"
          ]
        },
        "memoryContractVersion": {
          "description": "1: records before 2026-09-25 (macOS UI totals summed uptime-paired app and engine samples; at least 95% periodic coverage). 2: one memory series per process, a maximum unobserved gap bounded by the memory-qualification policy (each take records the bound it met), and each take's sampled peaks measured against the exact high-water marks.",
          "enum": [
            1,
            2
          ]
        },
        "memoryQualified": {
          "const": true
        },
        "sampleSidecarCount": {
          "minimum": 1,
          "type": "integer"
        },
        "sampleSidecarsDigest": {
          "$ref": "#/$defs/digest"
        },
        "memoryPolicyID": {
          "const": "retained-memory-v1"
        },
        "retentionMetric": {
          "const": "withinModeRetainedPhysicalFootprintGrowth"
        },
        "retentionThresholdFraction": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "maximumRetainedGrowthMB": {
          "minimum": 0,
          "type": "number"
        },
        "maximumRetainedGrowthFraction": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "retentionPassed": {
          "const": true
        },
        "retainedMemoryV2": {
          "additionalProperties": false,
          "description": "retained-memory-v2, reported beside retained-memory-v1 on memory-qualification records since 2026-09-25: within-mode growth of the MLX active memory at the end of each retained take. It gates only once calibrated: an uncalibrated block carries no bound and no verdict.",
          "properties": {
            "policyID": {
              "const": "retained-memory-v2"
            },
            "metric": {
              "const": "withinModeRetainedMLXActiveGrowth"
            },
            "calibration": {
              "enum": [
                "uncalibrated",
                "calibrated"
              ]
            },
            "growthByModeMB": {
              "type": "object"
            },
            "maximumRetainedGrowthMB": {
              "minimum": 0,
              "type": "number"
            },
            "growthLimitMBByMode": {
              "type": "object"
            },
            "passed": {
              "const": true
            }
          },
          "required": [
            "policyID",
            "metric",
            "calibration",
            "growthByModeMB",
            "maximumRetainedGrowthMB"
          ],
          "type": "object"
        },
        "streamingTelemetryV9SidecarCount": {
          "minimum": 0,
          "type": "integer"
        },
        "streamingTelemetryV9SidecarsDigest": {
          "$ref": "#/$defs/digest"
        },
        "streamingTelemetryV9PublicationReadyCount": {
          "minimum": 0,
          "type": "integer"
        },
        "cellAggregateVersion": {
          "description": "How the record's cells summarize its takes (audit #30). Absent means 1: every take of a cell, an IQR from two or more takes. 2: a take flagged followsColdTake stays out of its cell's statistics, and an IQR is published only from at least four takes (null below).",
          "enum": [
            1,
            2
          ]
        }
      },
      "required": [
        "manifestDigest",
        "validatorSchemaVersion",
        "telemetrySchemaVersion",
        "qcAlgorithmVersion",
        "validatorPassed",
        "crashDeltaPassed",
        "crashCount",
        "expectedTakeCount",
        "actualTakeCount",
        "resultBundleDigest",
        "rawTelemetryDigest",
        "selectedEvidenceDigest",
        "screenshotDigests"
      ],
      "type": "object"
    },
    "hardware": {
      "additionalProperties": false,
      "properties": {
        "chip": {
          "type": "string"
        },
        "cpuCores": {
          "minimum": 1,
          "type": "integer"
        },
        "efficiencyCores": {
          "minimum": 0,
          "type": "integer"
        },
        "freeStorageBytes": {
          "minimum": 0,
          "type": "integer"
        },
        "loadAverage1M": {
          "minimum": 0,
          "type": "number"
        },
        "lowPowerMode": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "marketingName": {
          "type": "string"
        },
        "memoryBytes": {
          "minimum": 1,
          "type": "integer"
        },
        "modelIdentifier": {
          "type": "string"
        },
        "osBuild": {
          "type": "string"
        },
        "osName": {
          "type": "string"
        },
        "osVersion": {
          "type": "string"
        },
        "performanceCores": {
          "minimum": 0,
          "type": "integer"
        },
        "profileID": {
          "enum": [
            "mac-mini-m2-8gb",
            "mac-mini-m6-16gb",
            "iphone-17-pro"
          ]
        },
        "thermalState": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "uptimeSeconds": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "profileID",
        "modelIdentifier",
        "marketingName",
        "chip",
        "memoryBytes",
        "cpuCores",
        "performanceCores",
        "efficiencyCores",
        "osName",
        "osVersion",
        "osBuild",
        "thermalState",
        "lowPowerMode",
        "transport",
        "loadAverage1M",
        "freeStorageBytes",
        "uptimeSeconds"
      ],
      "type": "object"
    },
    "inputs": {
      "additionalProperties": false,
      "properties": {
        "analysisProfileHash": {
          "type": "string"
        },
        "contractHash": {
          "type": "string"
        },
        "corpusHash": {
          "type": "string"
        },
        "dependencyLockHash": {
          "type": "string"
        },
        "harnessHash": {
          "type": "string"
        },
        "lineageContractVersion": {
          "description": "Comparison-key composition version of the per-kind lineage identity (scripts/lib/lineage_identity.py). Optional: absent on legacy records, whose comparison key stays byte-identical; when present, the other three lineage fields are present too. Version 2 adds a forced or emulated memory tier (run.runtimePolicy) and the run's seed policy to the key; version-1 records keep theirs.",
          "enum": [
            1,
            2
          ]
        },
        "lineageHarnessHash": {
          "description": "SHA-256 over the harness path list of this record kind and platform. Provenance only: never part of the comparison key.",
          "type": "string"
        },
        "lineageMeasurementVersion": {
          "description": "Reviewed measurement version of this record kind and platform; bumped when a change alters what the kind measures.",
          "minimum": 1,
          "type": "integer"
        },
        "lineageProjectHash": {
          "description": "SHA-256 of the project.yml build-settings subset the lane builds, or not-applicable.",
          "type": "string"
        },
        "matrixHash": {
          "type": "string"
        },
        "projectInputHash": {
          "type": "string"
        }
      },
      "required": [
        "contractHash",
        "dependencyLockHash",
        "projectInputHash",
        "harnessHash",
        "matrixHash",
        "corpusHash",
        "analysisProfileHash"
      ],
      "type": "object"
    },
    "listening": {
      "additionalProperties": false,
      "properties": {
        "annotatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "maxLength": 500,
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-performed"
          ]
        }
      },
      "required": [
        "status",
        "note",
        "annotatedAt"
      ],
      "type": "object"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "artifactVersion": {
          "type": [
            "integer",
            "string"
          ]
        },
        "fixtureDigest": {
          "type": "string"
        },
        "integrityDigest": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "modelID": {
          "type": "string"
        },
        "quantization": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "runtimeProfileSignature": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "modelID",
        "variant",
        "quantization",
        "revision",
        "artifactVersion",
        "integrityDigest",
        "runtimeProfileSignature",
        "fixtureDigest"
      ],
      "type": "object"
    },
    "run": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "canonical",
            "focused",
            "exploratory",
            "instrumented",
            "partial"
          ]
        },
        "durationSeconds": {
          "minimum": 0,
          "type": "number"
        },
        "finishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ui-generation",
            "engine-generation",
            "language",
            "instrument-profile",
            "prosody-calibration",
            "memory-qualification",
            "ui-perf"
          ]
        },
        "label": {
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "type": "string"
        },
        "matrixScope": {
          "enum": [
            "canonical",
            "focused",
            "partial",
            "instrumented"
          ]
        },
        "platform": {
          "enum": [
            "macos",
            "ios"
          ]
        },
        "rtfDefinition": {
          "description": "Real-time factor semantics of take metrics. \"wall/audio\" (request wall seconds ÷ audio seconds, lower is faster) on every record published since 2026-09-12; absent on legacy records whose `rtf` is the inverted decode-loop speedup.",
          "enum": [
            "wall/audio"
          ]
        },
        "seedPolicy": {
          "description": "How every take chose its sampling seed (scripts/lib/bench_seed.py, audit #29): generated (random per take), requested (a seed each request named) or cell-hash-v1 (the benchmark seed policy: each take's seed hashes its cell ID, and every take publishes it). Optional; lineage contract 2 keys it.",
          "enum": [
            "cell-hash-v1",
            "generated",
            "requested"
          ]
        },
        "runtimePolicy": {
          "additionalProperties": false,
          "description": "Run-level memory-tier provenance from the engine rows' own stamps: the device class the rows ran under, whether QWENVOICE_FORCE_MEMORY_CLASS forced it or QWENVOICE_SIMULATED_PHYSICAL_MEMORY_GB emulated a smaller Mac (both forced), and the emulated RAM in MB. Optional; absent on records published before 2026-09-25. Lineage contract 2 keys a forced or emulated tier apart from the host's; contract 1 never read it.",
          "properties": {
            "deviceClass": {
              "enum": [
                "floor_8gb_mac",
                "high_memory_mac",
                "iphone_pro",
                "mid_16gb_mac"
              ]
            },
            "deviceClassForced": {
              "type": "boolean"
            },
            "simulatedPhysicalMemoryMB": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "deviceClass",
            "deviceClassForced"
          ],
          "type": "object"
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "passedWithWarnings"
          ]
        },
        "ttfcDefinition": {
          "description": "What the takes' `ttfcMS` measures, on records since 2026-09-25 that carry one: \"cli-submit-to-first-chunk\" (macOS CLI bench: its own submission to the first chunk its stream observer receives) or \"engine-prepare-to-first-chunk\" (iOS device runner: the engine recorder's first-chunk mark from prepare entry). Absent on older records.",
          "enum": [
            "cli-submit-to-first-chunk",
            "engine-prepare-to-first-chunk"
          ]
        },
        "warnings": {
          "items": {
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}(?:\\([0-9]+/[0-9]+(?:-[0-9]+)?\\))?$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "platform",
        "label",
        "startedAt",
        "finishedAt",
        "durationSeconds",
        "status",
        "matrixScope",
        "classification",
        "warnings"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "changedPaths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "fingerprintsMatch": {
          "type": "boolean"
        },
        "postFingerprint": {
          "$ref": "#/$defs/digest"
        },
        "preFingerprint": {
          "$ref": "#/$defs/digest"
        },
        "workspaceFingerprint": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "commit",
        "dirty",
        "changedPaths",
        "workspaceFingerprint",
        "preFingerprint",
        "postFingerprint",
        "fingerprintsMatch"
      ],
      "type": "object"
    },
    "take": {
      "additionalProperties": false,
      "properties": {
        "audioQC": {
          "$ref": "#/$defs/audioQC"
        },
        "cell": {
          "type": "string"
        },
        "detectedLanguages": {
          "description": "Language takes since 2026-09-25: the language each cited recognizer family detected (Apple Speech from its locked transcript, whisper from the audio), so a misattributed verdict is visible.",
          "type": "object"
        },
        "followsColdTake": {
          "description": "UI benchmark takes since 2026-09-25 (audit #30): present and true only on the first take after a cold take, which pays a settling cost; cell aggregate 2 leaves it out of its cell's statistics.",
          "const": true
        },
        "durationSeconds": {
          "minimum": 0,
          "type": "number"
        },
        "expectedOutcome": {
          "description": "Language negative control: a take whose output verification was expected to fail and did; the validator inverts its accuracy gate.",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "finishReason": {
          "type": "string"
        },
        "generationID": {
          "type": "string"
        },
        "layerCompleteness": {
          "type": "string"
        },
        "layers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "length": {
          "type": "string"
        },
        "metrics": {
          "type": "object"
        },
        "mode": {
          "type": "string"
        },
        "modelArtifactVersion": {
          "type": "string"
        },
        "modelID": {
          "type": "string"
        },
        "modelIntegrityDigest": {
          "$ref": "#/$defs/digest"
        },
        "modelQuantization": {
          "enum": [
            "4-bit",
            "8-bit",
            "unquantized"
          ]
        },
        "modelRepository": {
          "type": "string"
        },
        "modelRevision": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "playbackCaptureDigest": {
          "$ref": "#/$defs/digest",
          "description": "SHA-256 of the capture WAV the UI benchmark runner recorded from the app's own audio output (kept under the run artifacts, never in the registry)."
        },
        "playbackCaptureStatus": {
          "description": "Played-audio capture evidence for the take: captured (compared with the published WAV), silent, unavailable (no tap), referenceUnresolved, aborted.",
          "enum": [
            "captured",
            "silent",
            "unavailable",
            "referenceUnresolved",
            "aborted"
          ]
        },
        "playbackStartSource": {
          "enum": [
            "liveStream",
            "finalFile"
          ]
        },
        "runtimeProfileSignature": {
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "type": "integer"
        },
        "accuracyMetric": {
          "enum": [
            "wordErrorRate",
            "characterErrorRate"
          ]
        },
        "accuracyThreshold": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "fixtureDigest": {
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "passedWithWarnings"
          ]
        },
        "takeIndex": {
          "minimum": 1,
          "type": "integer"
        },
        "thermalState": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "warmState": {
          "type": "string"
        },
        "warnings": {
          "items": {
            "maxLength": 96,
