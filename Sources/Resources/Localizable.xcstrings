    "vocello.ui.unusualPacing": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unusual pacing detected"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rythme inhabituel détecté"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha detectado un ritmo inusual"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungewöhnliches Sprechtempo erkannt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo insolito rilevato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo incomum detectado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到异常节奏"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不自然なテンポを検出"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비정상적인 말하기 속도 감지"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружен необычный темп"
          }
        }
      }
    },
    "vocello.ui.reviewTake": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review this take or generate it again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez cette prise ou générez-la à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa esta toma o vuelve a generarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe diese Aufnahme oder erzeuge sie erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla questo take o generane un altro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira esta tomada ou gere outra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查此音频或重新生成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテイクを確認するか、再生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 테이크를 확인하거나 다시 생성하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте этот дубль или создайте его заново."
          }
        }
      }
    },
    "vocello.ui.timingAdvisory": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing requests aren’t honored — the voice can’t target a duration, so this may distort pacing instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes de durée ne sont pas respectées : la voix ne peut pas viser une durée précise, ce qui risque de déformer le rythme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se respetan las solicitudes de duración: la voz no puede ajustarse a una duración concreta y esto puede distorsionar el ritmo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitvorgaben werden nicht eingehalten – die Stimme kann keine bestimmte Dauer ansteuern. Solche Angaben können stattdessen das Sprechtempo verzerren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste di durata non vengono rispettate: la voce non può mirare a una durata precisa e questo potrebbe alterare il ritmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedidos de duração não são atendidos: a voz não consegue atingir uma duração específica, e isso pode distorcer o ritmo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时长要求不会被执行：语音无法精确控制目标时长，这类要求反而可能导致节奏异常。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長さの指定には対応していません。音声の長さを狙って調整できないため、かえってテンポが乱れることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길이 지시는 반영되지 않습니다. 음성은 특정 길이를 목표로 할 수 없어 오히려 말하기 속도가 왜곡될 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Указания длительности не выполняются: голос не может точно задать длину записи, и такие указания могут исказить темп."
          }
        }
      }
    },
    "vocello.ui.tonePlaceholderCalm": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. A calm narrator, warm and measured"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : une narration calme, chaleureuse et posée"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej., un narrador tranquilo, cálido y pausado"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. ein ruhiger Erzähler, warm und bedächtig"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. un narratore calmo, caldo e misurato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: um narrador calmo, acolhedor e cadenciado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：平静、温暖、从容的旁白"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：穏やかで温かく、落ち着いたナレーター"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 차분하고 따뜻하며 여유로운 내레이터"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "например: спокойный рассказчик, тёплый и размеренный"
          }
        }
      }
    },
    "vocello.ui.tonePlaceholderNews": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. An energetic news anchor, bright and fast"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : une présentation énergique, vive et rapide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej., un presentador de noticias enérgico, vivaz y rápido"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. ein energiegeladener Nachrichtensprecher, lebhaft und schnell"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. un conduttore energico, vivace e veloce"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: um apresentador de notícias enérgico, animado e rápido"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：精力充沛、明快、语速较快的新闻主播"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：明るくテンポの速い、活気あるニュースキャスター"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 활기차고 밝으며 빠른 뉴스 앵커"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "например: энергичный ведущий новостей, яркий и быстрый"
          }
        }
      }
    },
    "vocello.ui.tonePlaceholderWhisper": {
      "comment": "iOS interface guidance only; never substituted into model input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. Whispered, close-mic and breathy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : un murmure soufflé, proche du micro"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej., un susurro cercano al micrófono y con aire"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. geflüstert, mikrofonnah und hauchig"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. sussurrato, vicino al microfono e soffiato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: sussurrado, próximo ao microfone e soproso"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：贴近麦克风、带有气声的耳语"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：マイクに近い、息を含んだささやき声"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 마이크에 가까이 대고 숨소리를 섞은 속삭임"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "например: шёпот близко к микрофону, с придыханием"
          }
        }
      }
    },
    "vocello.ui.tonePlaceholderGentle": {
      "comment": "iOS interface guidance only; never substituted into model input.",
