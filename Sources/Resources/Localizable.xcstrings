    "vocello.mac.record.microphoneDenied": {
      "comment": "macOS interface: record sheet status when microphone permission is denied. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is denied. Enable it in System Settings to record."
          }
        },
        "fr": {
