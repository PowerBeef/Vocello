      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice cloning works best with 10–20 seconds of clean speech."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clonage vocal fonctionne mieux avec 10 à 20 secondes de parole claire."
          }
        }
      }
    },
    "vocello.ui.qualityHard": {
      "comment": "iOS display-only qualityHard; preserve model IDs, prompt text and warning policy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a clip that is 60 seconds or shorter to use it for cloning."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un clip de 60 secondes ou moins pour le clonage."
          }
        }
      }
    },
    "vocello.ui.qualitySoft": {
      "comment": "iOS display-only qualitySoft; preserve model IDs, prompt text and warning policy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
