    "vocello.history.export_recovery_files": {
      "comment": "User-directed export of retained audio and private recovery journals; not an upload or repair.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Recovery Files"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter les fichiers de récupération"
          }
        }
      }
    },
    "vocello.history.long_form_recovery_detail": {
      "comment": "Explains non-destructive recovery and the privacy implications of exporting an unresolved project journal.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-form recovery is incomplete. Unrelated clips remain readable; project changes are blocked. Retry a temporary storage failure, or export recovery files for repair. These private files may contain script text and local paths. Exporting does not repair or delete them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération du projet long est incomplète. Les autres clips restent consultables ; les modifications du projet sont bloquées. Réessayez en cas de problème de stockage temporaire ou exportez les fichiers de récupération pour les réparer. Ces fichiers privés peuvent contenir le texte du script et des chemins locaux. L’exportation ne les répare ni ne les supprime."
          }
        }
      }
    },
    "vocello.long_form.segment_history_failed": {
      "comment": "Successful segment synthesis is distinct from History persistence and whole-project acceptance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The segment audio was generated, but History could not finish saving it. Open History to retry storage or export the retained audio before quitting. The project has not been accepted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio du segment a été généré, mais son enregistrement dans l’historique n’a pas pu être terminé. Ouvrez l’historique pour réessayer ou exporter l’audio conservé avant de quitter. Le projet n’a pas été validé."
          }
        }
      }
    },
    "vocello.history.recovery_export_failure": {
      "comment": "Number of recovery files that failed a user-directed local export; originals remain retained.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld recovery file could not be exported."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld recovery files could not be exported."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld fichier de récupération n’a pas pu être exporté."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld fichiers de récupération n’ont pas pu être exportés."
                }
              }
            }
          }
        }
      }
    },
    "vocello.history.unqueued_title": {
      "comment": "Successful synthesis with a failure to durably queue its History record; not an engine failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio ready — History not saved"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio prêt — historique non enregistré"
          }
        }
      }
    },
    "vocello.history.unqueued_detail": {
      "comment": "Warning that unqueued History identity is held only in app-session memory, not crash-safe storage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is still available. Retry saving or export it before quitting; recovery has not been safely queued."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio reste disponible. Réessayez de l’enregistrer ou exportez-le avant de quitter ; sa récupération n’a pas pu être mise en attente de manière durable."
          }
        }
      }
    },
    "vocello.history.retry_save": {
      "comment": "Retries storage only, never speech generation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry History Save"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer l’enregistrement dans l’historique"
          }
        }
      }
    },
    "vocello.history.export_audio": {
