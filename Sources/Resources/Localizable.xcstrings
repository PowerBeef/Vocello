    "vocello.mac.savedVoice.addSubtitle": {
      "comment": "macOS interface: subtitle of the manual Add Voice Sample sheet. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a reference clip you own or have permission to use, then use it in Voice Cloning."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un extrait de référence qui vous appartient ou que vous avez la permission d’utiliser, puis utilisez-le dans Clonage vocal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
