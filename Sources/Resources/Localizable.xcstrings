    "vocello.mac.cloning.savedVoicesLoadError": {
      "comment": "macOS interface: notice when the saved voices list failed to load; %@ is the error text. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load saved voices right now. You can still clone from a file. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les voix enregistrées pour le moment. Vous pouvez encore cloner à partir d’un fichier. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
