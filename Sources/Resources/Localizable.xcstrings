    "vocello.mac.batch.tooLarge": {
      "comment": "macOS interface: batch validation error; the first %@ is the segment count, the second the maximum. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch is too large: %@ segments exceeds the maximum of %@. Please split the text and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lot est trop volumineux : %@ segments dépassent le maximum de %@. Divisez le texte et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lote es demasiado grande: %@ segmentos supera el máximo de %@. Divide el texto y reinténtalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapel zu groß: %@ Abschnitte überschreiten das Maximum von %@. Teile den Text auf und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch troppo grande: %@ segmenti supera il massimo di %@. Dividi il testo e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lote muito grande: %@ segmentos excede o máximo de %@. Divida o texto e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批次过大：%@ 个片段超过上限 %@。请拆分文本后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一括処理が大きすぎます。%@ 区間は上限 %@ を超えています。テキストを分割して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일괄 작업이 너무 큽니다. %@개 구간이 최대 %@개를 넘습니다. 텍스트를 나눠 다시 시도하세요."
