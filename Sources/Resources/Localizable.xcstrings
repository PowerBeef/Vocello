    "vocello.history.unqueued_title": {
      "comment": "Successful synthesis with a failure to durably queue its History record; not an engine failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio ready — History not saved"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio prêt — historique non enregistré"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio listo; historial sin guardar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio bereit – Verlauf nicht gespeichert"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio pronto, cronologia non salvata"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Áudio pronto — histórico não salvo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频已就绪，历史记录未保存"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は準備完了 — 履歴は未保存"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 준비됨 — 기록 저장 안 됨"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
