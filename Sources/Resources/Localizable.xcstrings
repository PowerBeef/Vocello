    "vocello.export.free_detail": {
      "comment": "Settings refinement: preserve consent, free functionality and product meaning. No placeholder prices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generation, listening, and History are free in every mode. Built-in voice exports are free too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La génération, l’écoute et l’historique sont gratuits dans tous les modes. Les exports de voix intégrées sont gratuits aussi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Generar, escuchar y usar el historial es gratis en todos los modos. Exportar voces integradas también es gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzeugen, Anhören und Verlauf sind in allen Modi kostenlos. Auch Exporte integrierter Stimmen sind kostenlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Generazione, ascolto e cronologia sono gratuiti in ogni modalità. Anche le esportazioni delle voci integrate sono gratuite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerar, ouvir e usar o histórico são gratuitos em todos os modos. Exportar vozes integradas também é gratuito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有模式均可免费生成、收听并使用历史记录。内置声音的导出也免费。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのモードで生成、試聴、履歴は無料です。内蔵ボイスの書き出しも無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 모드에서 생성, 듣기, 기록은 무료입니다. 내장 음성 내보내기도 무료입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Генерация, прослушивание и история бесплатны во всех режимах. Экспорт встроенных голосов тоже бесплатный."
          }
        }
      }
    },
