    "vocello.export.unlock_detail": {
      "comment": "iOS one-time export unlock. Live price comes from StoreKit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate, listen, and keep every take in History for free. Built-in exports are free. A one-time purchase unlocks sharing and saving Voice Design and Voice Clone audio outside Vocello on iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générez, écoutez et conservez gratuitement chaque prise dans l’historique. Les exports de voix intégrées sont gratuits. Un achat unique débloque le partage et l’enregistrement de l’audio Voice Design et Voice Clone hors de Vocello sur iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera, escucha y conserva todas las tomas en el historial gratis. Exportar voces integradas es gratis. Una compra única permite compartir y guardar fuera de Vocello el audio de Diseño de voz y Clonación de voz en iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzeuge und höre Aufnahmen kostenlos an und behalte sie im Verlauf. Exporte integrierter Stimmen sind kostenlos. Ein Einmalkauf schaltet unter iOS das Teilen und Speichern von Stimmdesign- und Stimmklon-Audio außerhalb von Vocello frei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera, ascolta e conserva gratis ogni take nella cronologia. Le esportazioni integrate sono gratuite. Un acquisto singolo sblocca la condivisione e il salvataggio dell’audio di Design vocale e Clonazione vocale fuori da Vocello su iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere, ouça e mantenha todas as tomadas no histórico gratuitamente. Exportar vozes integradas é gratuito. Uma compra única permite compartilhar e salvar áudio de Criação de voz e Clonagem de voz fora do Vocello no iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费生成、收听并在历史记录中保留所有音频。内置声音导出免费。一次性购买可在 iOS 上解锁将声音设计和声音克隆音频分享、保存到 Vocello 之外的功能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成、試聴、履歴への保存は無料です。内蔵ボイスの書き出しも無料です。買い切りで、iOS のボイスデザインとボイスクローン音声を Vocello の外に共有・保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료로 생성하고 듣고 모든 테이크를 기록에 보관하세요. 내장 음성 내보내기는 무료입니다. 일회성 구매로 iOS에서 음성 디자인 및 음성 복제 오디오를 Vocello 밖으로 공유하고 저장할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте, слушайте и храните все дубли в истории бесплатно. Экспорт встроенных голосов бесплатный. Разовая покупка открывает сохранение и отправку аудио из дизайна и клонирования голоса за пределы Vocello на iOS."
          }
        }
      }
    },
