    "vocello.presentation.longFormGuidance": {
      "comment": "Complete user-facing longFormGuidance message. Preserve substitutions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-form script — Vocello plans segments, streams each one, and joins them into a single take."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte long — Vocello planifie les segments, génère chacun en continu et les réunit en une seule prise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guion largo: Vocello planifica segmentos, transmite cada uno y los une en una sola toma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langtext – Vocello plant Abschnitte, überträgt sie einzeln und fügt sie zu einer Aufnahme zusammen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo lungo: Vocello pianifica i segmenti, li trasmette uno alla volta e li unisce in un solo take."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto longo — o Vocello planeja segmentos, transmite cada um e os une em uma única tomada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长文本：Vocello 会划分片段、逐段流式生成，再合并为一条音频。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長文 — Vocello が区間を計画し、順番にストリーミング生成して1つのテイクに結合します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 원고 — Vocello가 구간을 나누고 각각 스트리밍 생성한 다음 하나의 테이크로 합칩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длинный текст — Vocello делит его на сегменты, генерирует каждый потоком и объединяет в один дубль."
          }
        }
      }
    },
