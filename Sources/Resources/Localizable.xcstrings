    "vocello.mac.savedVoice.nameExists": {
      "comment": "macOS interface: validation message for a duplicate saved voice name; %@ is the name. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved voice named \"%@\" already exists. Choose a different name."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une voix enregistrée nommée « %@ » existe déjà. Choisissez un autre nom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una voz guardada llamada «%@». Elige otro nombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gespeicherte Stimme namens „%@“ existiert bereits. Wähle einen anderen Namen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già una voce salvata chiamata “%@”. Scegli un altro nome."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe uma voz salva chamada “%@”. Escolha outro nome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在名为“%@”的声音。请选择其他名称。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」という名前の声はすでにあります。別の名前を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 이름의 저장된 음성이 이미 있습니다. 다른 이름을 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
