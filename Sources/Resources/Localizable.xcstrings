    "vocello.mac.cloning.consentDetail": {
      "comment": "macOS interface: Voice Cloning readiness detail before the one-time consent. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the one-time acknowledgment below: clone only voices you have permission to use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez l’accord unique ci-dessous : ne clonez que des voix que vous avez la permission d’utiliser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma el consentimiento a continuación: clona solo voces para las que tengas permiso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige einmalig: Klone nur Stimmen, für die du eine Erlaubnis hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma il consenso una tantum qui sotto: clona solo voci che hai il permesso di usare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme o consentimento único abaixo: clone apenas vozes que você tem permissão para usar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认下方的一次性声明：仅克隆获准使用的声音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の一度限りの同意を確認してください。使用許可のある声だけをクローンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래의 일회성 동의를 확인하세요. 사용 허가가 있는 음성만 복제합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите однократное согласие ниже: клонируйте только голоса с разрешением на использование."
          }
        }
      }
    },
