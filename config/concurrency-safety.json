      "invariant": "Each utility confines mutation to its documented lock, actor, queue, or immutable capture lifetime; the memory-pressure snapshot uses OSAllocatedUnfairLock for cross-domain reads while dispatch-source lifecycle stays queue-confined.",
      "tests": [
        "Tests/VocelloCoreTests/GenerationEventDeliveryProbeTests.swift",
        "Tests/VocelloCoreTests/GenerationFailureDiagnosticLoggerTests.swift",
        "Tests/VocelloCoreTests/ActiveGenerationCoordinatorTests.swift"
