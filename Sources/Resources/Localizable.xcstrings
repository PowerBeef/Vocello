    "vocello.mac.startup.cannotContinue": {
      "comment": "macOS interface: startup diagnostics explanation. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app can't continue until its native resources are valid. You can retry the startup checks or copy the diagnostics for troubleshooting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ne peut pas continuer tant que ses ressources natives ne sont pas valides. Vous pouvez relancer les vérifications de démarrage ou copier les diagnostics pour le dépannage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no puede continuar hasta que sus recursos nativos sean válidos. Puedes reintentar las comprobaciones de inicio o copiar los diagnósticos para resolver el problema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App kann erst fortfahren, wenn ihre nativen Ressourcen gültig sind. Wiederhole die Startprüfungen oder kopiere die Diagnosedaten zur Fehlerbehebung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non può continuare finché le risorse native non sono valide. Puoi ripetere i controlli di avvio o copiare la diagnostica per risolvere il problema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não pode continuar até que seus recursos nativos sejam válidos. Você pode repetir as verificações de inicialização ou copiar os diagnósticos para resolver o problema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地原生资源有效后，应用才能继续。你可以重试启动检查，或复制诊断信息以排查问题。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブリソースが有効になるまでアプリを続行できません。起動時のチェックを再試行するか、診断情報をコピーして問題を調べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 리소스가 유효해야 앱을 계속할 수 있습니다. 시작 검사를 다시 시도하거나 진단 정보를 복사해 문제를 해결하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не может продолжить, пока его нативные ресурсы недействительны. Повторите проверки запуска или скопируйте диагностику для решения проблемы."
          }
        }
      }
    },
