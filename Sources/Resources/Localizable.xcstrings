    "vocello.mac.history.deleteErrorMessage": {
      "comment": "macOS interface: alert message when a take cannot be removed; %@ is the error text. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The generation could not be removed from History: %@ Try again after closing anything using the file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La génération n’a pas pu être retirée de l’historique : %@ Réessayez après avoir fermé tout ce qui utilise le fichier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar la generación del historial: %@ Cierra cualquier aplicación que esté usando el archivo y reinténtalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Generierung konnte nicht aus dem Verlauf entfernt werden: %@ Schließe alles, was die Datei verwendet, und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rimuovere la generazione dalla cronologia: %@ Chiudi tutto ciò che usa il file e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível remover a geração do histórico: %@ Feche tudo que usa o arquivo e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从历史记录移除生成结果：%@ 请关闭正在使用此文件的程序后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成結果を履歴から削除できませんでした：%@ ファイルを使用しているものを閉じて再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성 결과를 기록에서 제거하지 못했습니다: %@ 파일을 사용하는 프로그램을 닫고 다시 시도하세요."
