          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性确认。可随时在设置中查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度だけの同意です。設定でいつでも確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
