    "vocello.mac.cloning.readyIdentityOnlyDetail": {
      "comment": "macOS interface: Voice Cloning readiness detail when the reference has no transcript. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reference has no transcript, so only the voice's identity is cloned. Add a transcript to carry its pacing and emotion into the take."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette référence n’a pas de transcription : seule l’identité de la voix est clonée. Ajoutez une transcription pour transmettre son rythme et son émotion à la prise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta referencia no tiene transcripción, así que solo se clona la identidad vocal. Añade una transcripción para trasladar su ritmo y emoción a la toma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Referenz hat kein Transkript, daher wird nur die Stimmidentität geklont. Füge ein Transkript hinzu, um Tempo und Emotion in die Aufnahme zu übernehmen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo riferimento non ha trascrizione, quindi viene clonata solo l’identità vocale. Aggiungi una trascrizione per trasferire ritmo ed emozione al take."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta referência não tem transcrição, então somente a identidade vocal é clonada. Adicione uma transcrição para levar seu ritmo e emoção à tomada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此参考音频没有转录，因此仅克隆声音身份。添加转录可将节奏和情感带入生成音频。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この参照音声には文字起こしがないため、声の特徴だけをクローンします。テンポや感情も反映するには文字起こしを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 참조에는 녹취록이 없어 목소리의 정체성만 복제합니다. 리듬과 감정도 반영하려면 녹취록을 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У образца нет расшифровки, поэтому клонируются только особенности голоса. Добавьте текст, чтобы передать темп и эмоции в дубль."
          }
        }
      }
    },
