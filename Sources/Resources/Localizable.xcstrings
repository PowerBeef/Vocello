    "vocello.mac.settings.variationHelp": {
      "comment": "macOS interface: Settings footer under the Variation picker. Expressive, Balanced and Consistent are the picker's option names. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much takes vary when regenerating the same text. Expressive is the model's official sampling (liveliest); Balanced and Consistent trade some liveliness for steadier, more repeatable takes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Degré de variation des prises lorsque le même texte est régénéré. Expressif est l’échantillonnage officiel du modèle (le plus vivant) ; Équilibré et Constant échangent un peu de vivacité contre des prises plus stables et reproductibles."
          }
        }
      }
    },
    "vocello.mac.settings.generation": {
      "comment": "macOS interface: Settings section header. Presentation only.",
      "extractionState": "manual",
      "localizations": {
