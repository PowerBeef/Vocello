{
  "description": "Vocello repository lifecycle hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/hooks/precommit_gate.sh\"",
            "statusMessage": "Running Vocello commit gate"
          }
        ]
      }
    ]
  }
}
