{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "comment": "System microphone permission for locally recording a cloning reference. Do not imply cloud recording.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello records reference clips to clone voices on-device and never uploads them. Saved voices are included in your iPhone backups."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello enregistre des clips de référence pour cloner des voix sur l’appareil et ne les envoie jamais. Les voix enregistrées sont incluses dans les sauvegardes de votre iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello graba clips de referencia para clonar voces en el dispositivo y nunca los sube. Las voces guardadas se incluyen en las copias de seguridad de tu iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello nimmt Referenzclips auf, um Stimmen auf dem Gerät zu klonen, und lädt sie nie hoch. Gespeicherte Stimmen sind in den Backups deines iPhone enthalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello registra clip di riferimento per clonare voci sul dispositivo e non le carica mai. Le voci salvate sono incluse nei backup del tuo iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vocello grava referências para clonar vozes no dispositivo e nunca as envia. As vozes salvas são incluídas nos backups do seu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello 录制参考音频，用于在设备上克隆声音，且从不上传。已保存的声音会包含在你的 iPhone 备份中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello はデバイス上で声をクローンするための参照音声を録音し、アップロードすることはありません。保存済みの声は iPhone のバックアップに含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello는 기기에서 음성을 복제하는 데 사용할 참조 오디오를 녹음하며 업로드하지 않습니다. 저장된 음성은 iPhone 백업에 포함됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello записывает образцы для клонирования голосов на устройстве и никогда их не выгружает. Сохранённые голоса входят в резервные копии iPhone."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "System Speech permission for on-device reference transcription. Do not imply remote transcription.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello transcribes your reference recording on-device to improve clone quality. Audio never leaves your iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello transcrit votre enregistrement de référence sur l’appareil pour améliorer la qualité du clonage. L’audio ne quitte jamais votre iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello transcribe la grabación de referencia en el dispositivo para mejorar la clonación. El audio nunca sale de tu iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello transkribiert deine Referenzaufnahme auf dem Gerät, um die Klonqualität zu verbessern. Das Audio verlässt dein iPhone nie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello trascrive la registrazione di riferimento sul dispositivo per migliorare la clonazione. L’audio non lascia mai il tuo iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vocello transcreve sua gravação de referência no dispositivo para melhorar a clonagem. O áudio nunca sai do seu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello 在设备上转录参考录音，以提高克隆质量。音频不会离开你的 iPhone。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello はクローンの品質を高めるため、参照音声をデバイス上で文字起こしします。音声が iPhone から出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello는 복제 품질을 높이기 위해 참조 녹음을 기기에서 받아씁니다. 오디오는 iPhone을 떠나지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello расшифровывает образец на устройстве для улучшения качества клонирования. Аудио никогда не покидает ваш iPhone."
          }
        }
      }
    }
  },
  "version": "1.0"
}
