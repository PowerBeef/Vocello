    "vocello.mac.custom.preparingDetail": {
      "comment": "macOS interface: Built-in Voice readiness detail while its model warms up. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading the Built-in Voice path. You can generate now; preparation finishes in the background."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement du parcours Voix intégrée. Vous pouvez générer dès maintenant ; la préparation se termine en arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando Voz integrada. Puedes generar ahora; la preparación termina en segundo plano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrierte Stimme wird geladen. Du kannst bereits erzeugen; die Vorbereitung läuft im Hintergrund weiter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricamento di Voce integrata. Puoi già generare; la preparazione termina in background."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregando Voz integrada. Você já pode gerar; a preparação termina em segundo plano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在载入内置声音。现在即可生成；准备将在后台完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵ボイスを読み込み中です。今すぐ生成でき、準備はバックグラウンドで完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 음성을 불러오는 중입니다. 지금 생성할 수 있으며 준비는 백그라운드에서 완료됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка встроенного голоса. Уже можно генерировать; подготовка завершится в фоне."
          }
        }
      }
    },
