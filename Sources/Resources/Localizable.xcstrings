    "vocello.settings.polish.modelsIntro": {
      "comment": "Settings polish; localized display only. Preserve placeholders and stored model/variation identities.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage your voice models and where finished audio is saved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez vos modèles vocaux et l’emplacement des fichiers audio enregistrés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona los modelos de voz y dónde se guarda el audio terminado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte Sprachmodelle und den Speicherort fertiger Audiodateien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci i modelli vocali e dove salvare l’audio finito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie os modelos de voz e onde o áudio finalizado é salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理语音模型和已完成音频的保存位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声モデルと、完成した音声の保存先を管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 모델과 완성된 오디오의 저장 위치를 관리하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте голосовыми моделями и местом сохранения готового аудио."
          }
        }
      }
    },
