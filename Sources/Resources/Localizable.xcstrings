          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルはメモリから解放されています。最初の生成時に再読み込みします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 메모리에서 내려갔습니다. 첫 생성 시 다시 불러옵니다."
          }
        },
        "ru": {
          "stringUnit": {
