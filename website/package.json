{
  "name": "vocello-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "node scripts/site-contract.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/rendered-contract.mjs",
    "build": "vite build && vite build --ssr src/entry-ssr.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "check": "npm run lint && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.0"
  }
}
