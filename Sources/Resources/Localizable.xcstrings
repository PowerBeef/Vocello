    "vocello.mac.settings.cloneConsent": {
      "comment": "macOS interface: voice cloning consent toggle title. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I own or have permission to clone the voices I use"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je possède les voix que je clone ou j’ai la permission de les utiliser"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soy titular de las voces que uso o tengo permiso para clonarlas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich besitze die verwendeten Stimmen oder darf sie klonen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possiedo le voci che uso o ho il permesso di clonarle"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sou dono das vozes que uso ou tenho permissão para cloná-las"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我拥有所用声音，或已获得克隆许可"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
