    "vocello.export.retry_export": {
      "comment": "iOS one-time export unlock. Live price comes from StoreKit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close this sheet and choose Share or Download again to export your selected clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez cette fenêtre, puis choisissez de nouveau Partager ou Télécharger pour exporter le clip sélectionné."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra esta hoja y vuelve a elegir Compartir o Descargar para exportar el clip seleccionado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe dieses Fenster und wähle erneut Teilen oder Laden, um den ausgewählten Clip zu exportieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi questo pannello e scegli di nuovo Condividi o Scarica per esportare il clip selezionato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche esta janela e escolha Compartilhar ou Baixar novamente para exportar o clipe selecionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此面板，再次选择“分享”或“下载”以导出所选音频。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシートを閉じ、共有またはダウンロードをもう一度選んで音声を書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시트를 닫고 공유 또는 다운로드를 다시 선택해 오디오를 내보내세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте это окно и снова выберите «Поделиться» или «Загрузить» для экспорта выбранной записи."
          }
        }
      }
    },
    "vocello.export.owned_unavailable": {
      "comment": "Product information failed to load, but the verified export entitlement remains active. Do not imply exports are blocked.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase information is currently unavailable. Your export unlock is still active; you can save and share audio in every mode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations d’achat sont actuellement indisponibles. L’exportation reste déverrouillée : vous pouvez enregistrer et partager l’audio dans tous les modes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información de compra no está disponible ahora. El desbloqueo sigue activo; puedes guardar y compartir audio en todos los modos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufinformationen sind derzeit nicht verfügbar. Deine Exportfreischaltung bleibt aktiv; du kannst Audio in allen Modi speichern und teilen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le informazioni sull’acquisto non sono disponibili. Lo sblocco rimane attivo; puoi salvare e condividere audio in ogni modalità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações da compra estão indisponíveis no momento. O desbloqueio continua ativo; você pode salvar e compartilhar áudio em todos os modos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买信息暂时不可用。导出解锁仍然有效；你可以保存和分享所有模式的音频。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入情報は現在利用できません。書き出し解除は有効なままで、すべてのモードの音声を保存・共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 구매 정보를 확인할 수 없습니다. 내보내기는 계속 활성화되어 있으며 모든 모드의 오디오를 저장하고 공유할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведения о покупке сейчас недоступны. Экспорт остаётся открытым; вы можете сохранять и отправлять аудио во всех режимах."
          }
        }
      }
    },
    "vocello.export.unavailable": {
