    "vocello.ui.installDetail": {
      "comment": "Onboarding explanation of separately downloaded models; Speed is the model-tier name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the 4-bit Speed model to start generating. Voice Design and Voice Cloning each have their own model; install them later in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
