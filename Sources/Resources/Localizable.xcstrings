    "vocello.mac.voices.useHelpInstall": {
      "comment": "macOS interface: tooltip of the Saved Voices row action when the Voice Cloning model is not installed. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Voice Cloning with this saved voice selected. Install the Voice Cloning model in Settings to generate from it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Clonage vocal avec cette voix enregistrée sélectionnée. Installez le modèle de clonage vocal dans Réglages pour générer avec elle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Clonación de voz con esta voz guardada seleccionada. Instala el modelo de Clonación de voz en Ajustes para generar con ella."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Stimmklonen mit dieser gespeicherten Stimme. Installiere das Stimmklonmodell in den Einstellungen, um damit Audio zu erzeugen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Clonazione vocale con questa voce salvata selezionata. Installa il modello di Clonazione vocale in Impostazioni per generare con essa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Clonagem de voz com esta voz salva selecionada. Instale o modelo de Clonagem de voz nos Ajustes para gerar com ela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开声音克隆并选中此已保存的声音。请在设置中安装声音克隆模型以生成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保存済みの声を選択してボイスクローンを開きます。生成するには設定でボイスクローンモデルをインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장된 음성을 선택한 상태로 음성 복제를 엽니다. 생성하려면 설정에서 음성 복제 모델을 설치하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает клонирование с выбранным сохранённым голосом. Установите модель клонирования в настройках для генерации."
          }
        }
      }
    },
