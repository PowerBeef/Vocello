    "vocello.mac.history.unavailableMessage": {
      "comment": "macOS interface: alert message when the History database cannot be opened. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry loading History before deleting any entries. Your existing database was preserved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez de charger l’historique avant de supprimer des entrées. Votre base de données existante a été préservée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintenta cargar el historial antes de eliminar entradas. Tu base de datos se ha conservado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade den Verlauf erneut, bevor du Einträge löschst. Deine vorhandene Datenbank wurde erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova a caricare la cronologia prima di eliminare voci. Il database esistente è stato conservato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente carregar o histórico novamente antes de excluir entradas. O banco de dados existente foi preservado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除任何条目前请重试载入历史记录。现有数据库已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を削除する前に履歴の読み込みを再試行してください。既存のデータベースは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 삭제하기 전에 기록 불러오기를 재시도하세요. 기존 데이터베이스는 보관되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите загрузку истории перед удалением записей. Существующая база данных сохранена."
          }
        }
      }
    },
