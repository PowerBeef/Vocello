    "vocello.ui.transcriptCaption": {
      "comment": "iOS interface: Auto-transcribed. With it, clones carry this clip's pacing and emotion; without it, identity only.. Presentation only; never use as a model prompt or stored identity.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-transcribed. With it, clones carry this clip's pacing and emotion; without it, identity only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription automatique. Avec elle, les clones reprennent le rythme et l’émotion du clip ; sans elle, seulement l’identité vocale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcripción automática. Con ella, la clonación conserva el ritmo y la emoción del clip; sin ella, solo la identidad vocal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch transkribiert. Mit Transkript übernimmt der Klon Tempo und Emotion des Clips; ohne nur die Stimmidentität."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione automatica. Con il testo, i cloni riprendono ritmo ed emozione del clip; senza, solo l’identità vocale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrição automática. Com ela, os clones reproduzem o ritmo e a emoção do clipe; sem ela, apenas a identidade vocal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已自动转录。有转录时，克隆会保留此音频的节奏和情感；没有转录时，仅保留声音身份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動文字起こしです。テキストがあるとテンポと感情もクローンに反映され、ない場合は声の特徴だけが反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 받아썼습니다. 녹취록이 있으면 리듬과 감정도 복제하며, 없으면 목소리의 정체성만 복제합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическая расшифровка. С ней клон передаёт темп и эмоции записи; без неё — только особенности голоса."
          }
        }
      }
    },
