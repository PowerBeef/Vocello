        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi generazione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar geração"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止生成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成を停止"
          }
        },
        "ko": {
          "stringUnit": {
