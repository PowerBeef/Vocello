    },
    "vocello.mac.settings.cloneConsentDetail": {
      "comment": "macOS interface: voice cloning consent detail. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only clone voices you own or have explicit permission to use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne clonez que des voix qui vous appartiennent ou dont vous avez l’autorisation explicite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clona únicamente voces propias o para las que tengas permiso explícito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klone nur eigene Stimmen oder solche, für die du eine ausdrückliche Erlaubnis hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clona solo voci che possiedi o che hai il permesso esplicito di usare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone apenas vozes que você possui ou tem permissão explícita para usar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅克隆你拥有或明确获准使用的声音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有する声、または明確な使用許可のある声だけをクローンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소유하고 있거나 명시적인 사용 허가를 받은 음성만 복제하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клонируйте только свои голоса или голоса с явным разрешением на использование."
          }
