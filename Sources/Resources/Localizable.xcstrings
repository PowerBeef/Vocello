    "vocello.mac.cloning.addReferenceDetail": {
      "comment": "macOS interface: Voice Cloning readiness detail without a reference clip. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved voices or imported clips both work. Pick one before writing the line."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voix enregistrées ou extraits importés conviennent. Choisissez-en un avant d’écrire la réplique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes usar voces guardadas o clips importados. Elige uno antes de escribir la frase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Stimmen und importierte Clips sind möglich. Wähle eine Referenz, bevor du den Text schreibst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanno bene voci salvate o clip importati. Scegline uno prima di scrivere la frase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vozes salvas ou clipes importados funcionam. Escolha um antes de escrever a fala."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存声音或导入音频均可。请先选择，再输入语句。"
          }
