  "generationMatrix": {
    "searchTokenBase": 28400001,
    "maxRows": 384,
    "modes": {
      "custom": {
        "dimensions": {
          "speaker": ["@speakers"],
          "delivery": ["@deliveries"],
          "language": ["@languages"],
          "variation": ["@variations"],
          "length": ["short", "long"]
