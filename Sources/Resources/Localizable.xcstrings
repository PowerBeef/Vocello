    "vocello.export.thanks": {
      "comment": "Settings refinement: preserve consent, free functionality and product meaning. No placeholder prices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for supporting Vocello. Your purchase helps fund its continued development and future independent projects."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de soutenir Vocello. Votre achat contribue à financer son développement et de futurs projets indépendants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por apoyar a Vocello. Tu compra ayuda a financiar su desarrollo continuo y futuros proyectos independientes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du Vocello unterstützt. Dein Kauf hilft, die Weiterentwicklung und künftige unabhängige Projekte zu finanzieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per il sostegno a Vocello. Il tuo acquisto contribuisce al suo sviluppo continuo e a futuri progetti indipendenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por apoiar o Vocello. Sua compra ajuda a financiar o desenvolvimento contínuo e futuros projetos independentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢你支持 Vocello。你的购买将帮助持续开发本应用和未来的独立项目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello を応援していただきありがとうございます。ご購入は継続的な開発と、今後の独立したプロジェクトを支えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello를 응원해 주셔서 감사합니다. 구매는 지속적인 개발과 앞으로의 독립 프로젝트에 도움이 됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо за поддержку Vocello. Ваша покупка помогает дальнейшей разработке и будущим независимым проектам."
          }
        }
      }
    },
