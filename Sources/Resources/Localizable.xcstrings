    "vocello.export.folder_detail": {
      "comment": "iOS one-time export unlock. Live price comes from StoreKit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All clips stay in History. An optional Files folder also receives new Built-in clips; Design and Clone copies require the export unlock. If purchase access is still being checked, export those clips manually from History afterward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les clips restent dans l’historique. Un dossier facultatif dans Fichiers reçoit aussi les nouveaux clips de voix intégrées ; les copies Design et Clone nécessitent le déblocage des exports. Si l’accès à l’achat est encore en cours de vérification, exportez ensuite ces clips manuellement depuis l’historique."
          }
        }
      }
    },
    "vocello.export.pending": {
