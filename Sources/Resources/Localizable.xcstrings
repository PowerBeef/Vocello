    "vocello.ui.voiceBankDetail": {
      "comment": "iOS complete message: voiceBankDetail. Substitutions retain original user content and numeric values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is a voice bank: the same voice with curated emotion references. Each delivery clones its measured reference clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est une banque vocale : une même voix avec des références émotionnelles sélectionnées. Chaque interprétation clone son clip de référence mesuré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ es un banco de voces: la misma voz con referencias de emociones seleccionadas. Cada interpretación clona su clip de referencia medido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist eine Stimmbank: dieselbe Stimme mit ausgewählten Emotionsreferenzen. Jede Sprechweise klont ihren gemessenen Referenzclip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è una banca vocale: la stessa voce con riferimenti emotivi selezionati. Ogni interpretazione clona il relativo clip di riferimento misurato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ é um banco de vozes: a mesma voz com referências emocionais selecionadas. Cada interpretação clona seu clipe de referência medido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 是一个声音库：同一种声音搭配精选情感参考。每种表达都会克隆其经过测量的参考音频。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は、同じ声に厳選した感情別参照音声を組み合わせたボイスバンクです。各話し方は、測定済みの参照音声をクローンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 같은 목소리에 엄선한 감정별 참조를 모은 음성 뱅크입니다. 각 표현은 측정된 참조 오디오를 복제합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — банк голосов: один голос с подобранными эмоциональными образцами. Каждая манера речи клонирует свой измеренный образец."
          }
        }
      }
    },
