    "vocello.mac.savedVoice.cloneSubtitle": {
      "comment": "macOS interface: subtitle when saving a clone result to Saved Voices. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this clone as a reusable reference for Voice Cloning when you have permission to use it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez ce clone comme référence réutilisable pour Clonage vocal lorsque vous avez la permission de l’utiliser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva este clon como referencia reutilizable para Clonación de voz si tienes permiso para usarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte diesen Klon als wiederverwendbare Referenz zum Stimmklonen, sofern du ihn verwenden darfst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva questo clone come riferimento riutilizzabile per Clonazione vocale se hai il permesso di usarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde este clone como referência reutilizável para Clonagem de voz quando tiver permissão para usá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在获准使用的前提下，将此克隆保存为可复用的声音克隆参考。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用許可がある場合、このクローンを再利用可能なボイスクローン用参照音声として保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 허가가 있는 경우 이 복제 음성을 재사용 가능한 음성 복제 참조로 보관하세요."
