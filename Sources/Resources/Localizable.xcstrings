    "vocello.player.dismiss_detail": {
      "comment": "Player dismissal does not guarantee that the take's History write succeeded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This closes the player without deleting the audio file. Saved takes can be replayed from History."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action ferme le lecteur sans supprimer le fichier audio. Les prises enregistrées peuvent être réécoutées depuis l’historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cierra el reproductor sin eliminar el archivo de audio. Las tomas guardadas se pueden reproducir desde el historial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies schließt den Player, ohne die Audiodatei zu löschen. Gespeicherte Aufnahmen lassen sich im Verlauf erneut abspielen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiude il lettore senza eliminare il file audio. I take salvati possono essere riascoltati dalla cronologia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha o player sem excluir o arquivo de áudio. Tomadas salvas podem ser reproduzidas pelo histórico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭播放器，不删除音频文件。已保存的音频可从历史记录再次播放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ファイルを削除せずにプレーヤーを閉じます。保存済みテイクは履歴から再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 파일을 삭제하지 않고 플레이어를 닫습니다. 저장된 테이크는 기록에서 다시 재생할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрывает плеер, не удаляя аудиофайл. Сохранённые дубли можно воспроизвести из истории."
          }
        }
      }
    },
    "vocello.long_form.save_failed": {
      "comment": "Long-form transaction rolled back without changing the prior accepted project.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The long-form project could not be saved safely. The previous accepted project is unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet long n’a pas pu être enregistré de manière sûre. Le projet précédemment validé reste inchangé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el proyecto de formato largo de forma segura. El proyecto anterior aceptado sigue intacto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Langtextprojekt konnte nicht sicher gespeichert werden. Das zuvor angenommene Projekt bleibt unverändert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il progetto lungo in sicurezza. Il progetto precedente accettato è invariato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o projeto longo com segurança. O projeto anterior aceito permanece intacto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全保存长文本项目。先前已接受的项目保持不变。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長文プロジェクトを安全に保存できませんでした。以前に受理されたプロジェクトは変更していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 원고 프로젝트를 안전하게 저장하지 못했습니다. 이전에 승인된 프로젝트는 그대로입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось безопасно сохранить длинный проект. Предыдущий принятый проект не изменён."
          }
        }
      }
    },
    "vocello.long_form.recovery_required": {
      "comment": "An interrupted or invalid long-form transaction needs reconciliation; retained audio must not be deleted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-form storage needs recovery. Open History and retry before changing this project. Its audio has been retained."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage du projet long nécessite une récupération. Ouvrez l’historique et réessayez avant de modifier ce projet. Son audio a été conservé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento del audio largo necesita recuperación. Abre el historial y reintenta antes de cambiar este proyecto. Su audio se ha conservado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Langtextspeicher muss wiederhergestellt werden. Öffne den Verlauf und versuche es erneut, bevor du dieses Projekt änderst. Das Audio wurde erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’archiviazione del progetto lungo richiede un recupero. Apri la cronologia e riprova prima di modificarlo. L’audio è stato conservato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do projeto longo precisa de recuperação. Abra o histórico e tente novamente antes de alterar este projeto. O áudio foi preservado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长文本存储需要恢复。请在修改项目之前打开历史记录并重试。音频已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長文プロジェクトの保存領域に復旧が必要です。変更する前に履歴を開いて再試行してください。音声は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 원고 저장소를 복구해야 합니다. 이 프로젝트를 변경하기 전에 기록을 열고 재시도하세요. 오디오는 보관되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище длинного проекта требует восстановления. Откройте историю и повторите попытку до изменения проекта. Аудио сохранено."
          }
        }
      }
    },
