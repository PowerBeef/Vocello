          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こし（クローンの再利用に推奨）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹취록(재사용할 복제에 권장)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка (рекомендуется для повторного клонирования)"
          }
        }
      }
    },
    "vocello.mac.savedVoice.transcriptHelp": {
      "comment": "macOS interface: Saved Voice sheet explanation under the transcript field. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript-backed voices can reuse prepared Qwen3 clone prompts; audio-only voices remain available as a lower-guidance fallback."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voix avec transcription peuvent réutiliser des amorces de clonage Qwen3 préparées ; les voix audio seulement restent disponibles comme repli moins guidé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las voces con transcripción pueden reutilizar las preparaciones de clonación de Qwen3; las voces de solo audio siguen disponibles como alternativa con menos orientación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmen mit Transkript können vorbereitete Qwen3-Klonvorgaben wiederverwenden; reine Audiostimmen bleiben als weniger stark geführte Ausweichlösung verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci con trascrizione possono riutilizzare le preparazioni di clonazione Qwen3; le voci solo audio restano disponibili come alternativa con meno indicazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vozes com transcrição podem reutilizar as preparações de clonagem do Qwen3; vozes somente com áudio continuam disponíveis como alternativa com menos orientação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "含转录的声音可复用已准备的 Qwen3 克隆提示；仅音频声音仍可作为引导较少的备用方式使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こし付きの声は準備済み Qwen3 クローン指示を再利用できます。音声のみの声も、誘導の少ない代替方式として利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹취록이 있는 음성은 준비된 Qwen3 복제 지시를 재사용할 수 있습니다. 오디오만 있는 음성도 지침이 적은 대체 방식으로 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голоса с расшифровкой могут повторно использовать подготовленные данные клонирования Qwen3; голоса только с аудио остаются запасным вариантом с меньшим управлением."
          }
        }
      }
    },
