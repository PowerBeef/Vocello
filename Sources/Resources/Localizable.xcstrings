    "vocello.mac.history.recoveryUnverified": {
      "comment": "macOS interface: recovery banner detail when a queued take could not be verified. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello preserved the recovery record but could not verify or commit it. Retry before clearing History."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello a préservé l’enregistrement de récupération sans pouvoir le vérifier ni le valider. Réessayez avant d’effacer l’historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello conservó el registro de recuperación, pero no pudo verificarlo ni confirmarlo. Reintenta antes de vaciar el historial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello hat den Wiederherstellungsdatensatz erhalten, konnte ihn aber nicht prüfen oder übernehmen. Versuche es erneut, bevor du den Verlauf leerst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello ha conservato il record di recupero ma non ha potuto verificarlo o confermarlo. Riprova prima di svuotare la cronologia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vocello preservou o registro de recuperação, mas não conseguiu verificá-lo ou confirmá-lo. Tente novamente antes de limpar o histórico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello 保留了恢复记录，但无法验证或提交。清空历史记录前请重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello は復旧記録を保持しましたが、検証や確定ができませんでした。履歴を消去する前に再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello가 복구 기록을 보관했지만 검증하거나 확정하지 못했습니다. 기록을 지우기 전에 재시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocello сохранил запись восстановления, но не смог проверить или подтвердить её. Повторите попытку до очистки истории."
          }
        }
      }
    },
    "vocello.mac.history.recoveryQueuedOne": {
      "comment": "macOS interface: recovery banner detail for one queued take. Presentation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 take remains safely queued. You can retry, reveal, or export the audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 prise reste en file d’attente en sécurité. Vous pouvez réessayer, afficher ou exporter l’audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 toma sigue en cola de forma segura. Puedes reintentar, mostrar o exportar el audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Aufnahme bleibt sicher in der Warteschlange. Du kannst das Audio erneut speichern, anzeigen oder exportieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 take rimane al sicuro in coda. Puoi riprovare, mostrare o esportare l’audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 tomada permanece em segurança na fila. Você pode tentar novamente, mostrar ou exportar o áudio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 条音频仍安全保留在队列中。你可以重试、显示或导出音频。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1件のテイクが安全にキューに保持されています。音声の保存を再試行、表示、書き出しできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테이크 1개가 대기열에 안전하게 보관되어 있습니다. 오디오 저장을 재시도하거나 보거나 내보낼 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 дубль остаётся в безопасной очереди. Можно повторить сохранение, показать или экспортировать аудио."
          }
        }
      }
    },
