    "vocello.presentation.longFormGuidance": {
      "comment": "Complete user-facing longFormGuidance message. Preserve substitutions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-form script — Vocello plans segments, streams each one, and joins them into a single take."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte long — Vocello planifie les segments, génère chacun en continu et les réunit en une seule prise."
          }
        }
      }
    },
    "vocello.presentation.longFormLimit": {
      "comment": "Complete user-facing longFormLimit message. Preserve substitutions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the single-take limit; keep typing for a long-form project."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite d’une prise atteinte ; continuez à écrire pour créer un projet de texte long."
          }
        }
      }
    },
