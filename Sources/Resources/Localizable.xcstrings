    "vocello.settings.refinement.cloneDisclosure": {
      "comment": "Settings refinement: preserve consent, free functionality and product meaning. No placeholder prices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you publish audio of a cloned real voice, disclose that it is AI-generated. EU law may require this."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous publiez l’audio d’une voix réelle clonée, indiquez qu’il est généré par IA. Le droit de l’UE peut l’exiger."
          }
        }
      }
    },
    "vocello.settings.refinement.cloneDisclosureHint": {
      "comment": "Settings refinement: preserve consent, free functionality and product meaning. No placeholder prices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-generated audio disclosure. If you publish audio of a cloned real voice, disclose that it is AI-generated. EU law may require this."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mention de l’audio généré par IA. Si vous publiez l’audio d’une voix réelle clonée, indiquez qu’il est généré par IA. Le droit de l’UE peut l’exiger."
          }
        }
      }
    },
