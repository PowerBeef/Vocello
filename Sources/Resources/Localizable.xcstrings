    "vocello.ui.onboardingReadyDetail": {
      "comment": "Final onboarding page explains that model installation is still required.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download a voice model in Settings, then type a script, pick a voice, generate. Your audio stays here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez un modèle vocal dans Réglages, puis saisissez un script, choisissez une voix et générez. Votre audio reste ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga un modelo de voz en Ajustes, escribe un guion, elige una voz y genera. Tu audio se queda aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade ein Sprachmodell in den Einstellungen, schreibe einen Text, wähle eine Stimme und erzeuge Audio. Dein Audio bleibt hier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica un modello vocale in Impostazioni, scrivi un testo, scegli una voce e genera. L’audio resta qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe um modelo de voz nos Ajustes, digite um texto, escolha uma voz e gere. Seu áudio fica aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中下载语音模型，然后输入文本、选择声音并生成。音频会保留在这里。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で音声モデルをダウンロードし、原稿を入力して声を選び、生成してください。音声はここに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 음성 모델을 다운로드하고 원고를 입력한 뒤 음성을 선택해 생성하세요. 오디오는 여기에 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите голосовую модель в настройках, введите текст, выберите голос и создайте аудио. Оно останется здесь."
